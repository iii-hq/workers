{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "CloudConfig": {
      "additionalProperties": false,
      "properties": {
        "access_token": {
          "default": "",
          "format": "password",
          "type": "string",
          "writeOnly": true
        },
        "api_version": {
          "default": "v26.0",
          "type": "string"
        },
        "app_secret": {
          "default": "",
          "format": "password",
          "type": "string",
          "writeOnly": true
        },
        "business_account_id": {
          "default": "",
          "type": "string"
        },
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "phone_number_id": {
          "default": "",
          "type": "string"
        },
        "verify_token": {
          "default": "",
          "format": "password",
          "type": "string",
          "writeOnly": true
        },
        "flow_private_key": {
          "type": "string",
          "default": "",
          "format": "password",
          "writeOnly": true,
          "maxLength": 16384,
          "description": "Optional unencrypted PEM RSA-2048 private key for the Flow data exchange endpoint. Prefer WHATSAPP_FLOW_PRIVATE_KEY."
        },
        "flow_handler_function": {
          "type": "string",
          "default": "",
          "maxLength": 256,
          "description": "iii function that receives decrypted Flow data and returns screen and data."
        },
        "flow_handler_namespace": {
          "type": "string",
          "default": "",
          "maxLength": 256,
          "description": "Namespace of the Flow handler. Empty uses this worker namespace."
        }
      },
      "type": "object"
    }
  },
  "example": {
    "cloud": {
      "access_token": "",
      "api_version": "v26.0",
      "app_secret": "",
      "business_account_id": "",
      "enabled": false,
      "phone_number_id": "",
      "verify_token": ""
    },
    "data_dir": "data/whatsapp-go",
    "device_name": "",
    "device_platform": "desktop",
    "max_events": 1000,
    "max_inbox_messages": 10000,
    "max_media_bytes": 16777216,
    "max_sessions": 32,
    "operation_timeout_secs": 30,
    "shutdown_timeout_secs": 15,
    "database": {
      "name": "whatsapp",
      "namespace": ""
    }
  },
  "properties": {
    "cloud": {
      "allOf": [
        {
          "$ref": "#/definitions/CloudConfig"
        }
      ],
      "default": {
        "access_token": "",
        "api_version": "v26.0",
        "app_secret": "",
        "business_account_id": "",
        "enabled": false,
        "phone_number_id": "",
        "verify_token": ""
      },
      "description": "Optional official Meta integration; independent of linked-device sessions."
    },
    "data_dir": {
      "default": "data/whatsapp-go",
      "description": "Private local session metadata and immutable legacy database backups. Message archives and native keys are stored through the database worker.",
      "minLength": 1,
      "type": "string"
    },
    "device_name": {
      "default": "",
      "description": "Name a newly paired device shows in the phone's Linked devices list. Empty keeps the generic \"Other device\" entry. Applies only to new pairings: an already linked device keeps its name until it is unlinked and the QR code is scanned again. Changing this requires a worker restart.",
      "maxLength": 64,
      "type": "string"
    },
    "device_platform": {
      "default": "desktop",
      "description": "Platform type a newly paired device reports with device_name; the phone picks the entry's icon from it. Ignored while device_name is empty. Applies only to new pairings and requires a worker restart.",
      "enum": [
        "unknown",
        "chrome",
        "firefox",
        "ie",
        "opera",
        "safari",
        "edge",
        "desktop",
        "ipad",
        "android_tablet",
        "ohana",
        "aloha",
        "catalina",
        "tcl_tv",
        "ios_phone",
        "ios_catalyst",
        "android_phone",
        "android_ambiguous",
        "wear_os",
        "ar_wrist",
        "ar_device",
        "uwp",
        "vr",
        "cloud_api",
        "smartglasses"
      ],
      "type": "string"
    },
    "max_events": {
      "default": 1000,
      "description": "Event retention and broadcast capacity. Changing this requires a worker restart.",
      "format": "uint",
      "maximum": 100000,
      "minimum": 1,
      "type": "integer"
    },
    "max_inbox_messages": {
      "default": 10000,
      "description": "Maximum retained inbox messages per session; lowering this trims oldest rows live.",
      "format": "uint",
      "maximum": 100000,
      "minimum": 1,
      "type": "integer"
    },
    "max_media_bytes": {
      "default": 16777216,
      "format": "uint",
      "maximum": 67108864,
      "minimum": 1,
      "type": "integer"
    },
    "max_sessions": {
      "default": 32,
      "description": "Maximum number of sessions; existing sessions survive a lower limit.",
      "format": "uint",
      "maximum": 1024,
      "minimum": 1,
      "type": "integer"
    },
    "operation_timeout_secs": {
      "default": 30,
      "format": "uint64",
      "maximum": 600,
      "minimum": 1,
      "type": "integer"
    },
    "shutdown_timeout_secs": {
      "default": 15,
      "format": "uint64",
      "maximum": 120,
      "minimum": 1,
      "type": "integer"
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "description": "Dedicated database worker SQLite pool. Changes require a restart. Empty namespace uses the WhatsApp namespace.",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "default": "whatsapp"
        },
        "namespace": {
          "type": "string",
          "maxLength": 256,
          "default": ""
        }
      },
      "default": {
        "name": "whatsapp",
        "namespace": ""
      }
    }
  },
  "title": "Config",
  "type": "object"
}
