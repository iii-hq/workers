        { "tag": 19, "name": "listFill", "type": "bool", "default": false, "doc": "Wide only: while showDetail is false the list takes the whole width (no detail column, no emptyDetail, no hide button); with showDetail the list has its usual width beside the detail." }
      ],
      "events": ["dismiss"],
      "slots": [
