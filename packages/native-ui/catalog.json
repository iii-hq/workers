      "props": [
        { "tag": 16, "name": "titles", "type": "strings", "default": [], "doc": "One per lane, in order." },
        { "tag": 17, "name": "counts", "type": "strings", "default": null, "doc": "Per lane, a short text after the title (a count: 5, 99+); null or a missing entry = none." },
        { "tag": 18, "name": "selected", "type": "int", "default": 0, "doc": "One lane per page: the lane in view. Columns: the lane the host scrolls into view when this changes." },
        { "tag": 19, "name": "laneWidth", "type": "dp", "default": 300, "doc": "The width of a column. The host shows columns side by side when at least two fit its width (they share the width when all fit), else one lane per page under a tab strip." }
      ],
      "events": ["select"],
      "slots": [{ "slot": 0, "name": "lanes", "many": true }]
    },
    {
      "tag": 40, "name": "Page", "group": "chrome", "consoleUi": "PageShell / PageHeader",
      "props": [
        { "tag": 16, "name": "title", "type": "string", "default": "" },
        { "tag": 17, "name": "subtitle", "type": "string", "default": null },
        { "tag": 18, "name": "subtitleMono", "type": "bool", "default": false },
        { "tag": 19, "name": "topBar", "type": "bool", "default": true }
      ],
      "events": [],
      "slots": [
        { "slot": 0, "name": "body", "many": true },
        { "slot": 1, "name": "actions", "many": true },
