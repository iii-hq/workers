    {
      "tag": 64, "name": "RemoteScreen", "group": "highLevel", "consoleUi": null,
      "props": [
        { "tag": 16, "name": "session", "type": "string", "default": "" },
        { "tag": 17, "name": "wire", "type": "json", "default": null },
        { "tag": 18, "name": "enabled", "type": "bool", "default": true },
        { "tag": 19, "name": "mode", "type": "enum", "enum": "remoteMode", "default": 0 },
        { "tag": 20, "name": "mobile", "type": "bool", "default": true },
        { "tag": 21, "name": "keyboard", "type": "bool", "default": false },
        { "tag": 22, "name": "placeholder", "type": "string", "default": null },
        { "tag": 23, "name": "maxScale", "type": "float", "default": 3 }
      ],
      "events": ["longPress", "frame", "error", "keyboard", "ready"],
      "slots": []
    }
  ],
  "remoteScreen": {
    "doc": "The wire prop: function ids and argument templates. Every fn and trigger must be in the app's own namespace. In args, a string value equal to a placeholder is replaced by the typed value; any other value is copied as is; a placeholder whose value is absent drops its key.",
    "wireKeys": ["frames", "seed", "start", "stop", "resize", "input"],
    "placeholders": {
      "$session": "string: the session prop",
      "$viewer": "string: a viewer id, new on every activation: <connection browserId>-<node id>-<n> (the browserId starts with android-)",
      "$scale": "float: min(screen density, maxScale, 3), 2 decimals",
      "$w": "int: the view width in dp (page CSS px)",
      "$h": "int: the view height in dp",
      "$dpr": "float: the screen density",
      "$mobile": "bool: the mobile prop",
      "$seq": "int: the last frame_seq painted (absent before the first)",
      "$x": "float: page x (CSS px) of the gesture",
      "$y": "float: page y (CSS px) of the gesture",
      "$count": "int: click count (1, or 2 for the second tap of a double tap)",
      "$dx": "float: horizontal scroll in CSS px (positive scrolls right)",
      "$dy": "float: vertical scroll in CSS px (positive scrolls down)",
      "$text": "string: committed text to type",
      "$key": "string: Enter, Tab, Escape, Backspace, Delete, ArrowUp, ArrowDown, ArrowLeft, ArrowRight, Home, End, PageUp, PageDown"
    },
    "framePayload": {
      "frame": "string: base64 JPEG, PNG or WebP (sniffed by magic bytes)",
      "width": "int: page width the frame maps to (the input coordinate space)",
      "height": "int: page height",
      "frame_seq": "int: increases per frame of a session; a frame at or below the last painted is dropped",
      "session_id": "string, optional: when present it must equal $session"
    }
  },
  "protocol": {
    "vmToHost": [
      { "code": 1, "name": "create", "fields": [["id", "int"], ["type", "int"]] },
      { "code": 2, "name": "set", "fields": [["id", "int"], ["prop", "int"], ["value", "json"]], "doc": "value null resets the prop to its default." },
      { "code": 3, "name": "insert", "fields": [["parent", "int"], ["slot", "int"], ["index", "int"], ["child", "int"]], "doc": "child must be detached; index 0..count of that slot." },
      { "code": 4, "name": "move", "fields": [["parent", "int"], ["slot", "int"], ["from", "int"], ["to", "int"]], "doc": "Moves one child within a slot; to is the index after removal." },
      { "code": 5, "name": "remove", "fields": [["parent", "int"], ["slot", "int"], ["index", "int"]], "doc": "Detaches the child at index; it stays alive until destroy or a new insert." },
      { "code": 6, "name": "destroy", "fields": [["id", "int"]], "doc": "Frees the node and every node still attached under it." },
      { "code": 7, "name": "root", "fields": [["page", "int"], ["id", "int"]], "doc": "The root node of a mounted page instance; id 0 clears it." },
      { "code": 8, "name": "listSplice", "fields": [["list", "int"], ["start", "int"], ["deleteCount", "int"], ["items", "json"]], "doc": "items: an array of JSON objects, each with its key field." },
      { "code": 20, "name": "request", "fields": [["reqId", "int"], ["method", "int"], ["args", "json"]] },
      { "code": 23, "name": "ready", "fields": [["info", "json"]], "doc": "Once, when the bundle called defineApp: {sdk, catalog, features, pages: [{name, modal, fullScreen}]}." }
    ],
    "hostToVm": [
      { "code": 1, "name": "init", "fields": [["info", "json"]], "doc": "{catalog, features, host, engine, app: {key, ns}, env: Env}." },
      { "code": 2, "name": "event", "fields": [["node", "int"], ["event", "int"], ["args", "json"]] },
      { "code": 3, "name": "itemEvent", "fields": [["list", "int"], ["key", "json"], ["node", "int"], ["event", "int"], ["args", "json"]], "doc": "An event of a template node, for the item with that key." },
      { "code": 4, "name": "text", "fields": [["node", "int"], ["count", "int"], ["text", "string"]], "doc": "TextField edit; count = the host's edits so far for that node. Only the last per node is kept within one message." },
      { "code": 5, "name": "env", "fields": [["changes", "json"]], "doc": "Only the Env keys that changed." },
      { "code": 6, "name": "mount", "fields": [["page", "int"], ["name", "string"], ["params", "json"]], "doc": "page: a host-allocated page instance id, stable across VM restarts." },
      { "code": 7, "name": "unmount", "fields": [["page", "int"]] },
      { "code": 8, "name": "response", "fields": [["reqId", "int"], ["ok", "int"], ["value", "json"]], "doc": "ok 1: value is the result; ok 0: value is {code, message}." },
      { "code": 9, "name": "trigger", "fields": [["sub", "int"], ["payload", "json"]] }
    ],
    "requests": [
      { "method": 1, "name": "call", "args": { "fn": "string", "payload": "json?", "timeoutMs": "int?" }, "result": "json (the function's result)" },
      { "method": 2, "name": "on", "args": { "sub": "int", "trigger": "string", "config": "json" }, "result": "null once bound" },
      { "method": 3, "name": "off", "args": { "sub": "int" }, "result": "null" },
      { "method": 10, "name": "navPush", "args": { "page": "string", "params": "json?" }, "result": "{result: json|null} when the pushed card leaves" },
      { "method": 11, "name": "navPop", "args": { "page": "int", "result": "json?" }, "result": "null" },
      { "method": 12, "name": "navReplace", "args": { "page": "int", "name": "string", "params": "json?" }, "result": "null" },
      { "method": 13, "name": "navPopToRoot", "args": {}, "result": "null" },
      { "method": 20, "name": "toast", "args": { "text": "string", "kind": "enum toastKind?" }, "result": "null" },
      { "method": 21, "name": "actionMenu", "args": { "anchor": "int?", "title": "string?", "subtitle": "string?", "actions": "[{label, icon?, destructive?, hint?, checked?}]" }, "result": "{index: int} (-1 when dismissed)" },
      { "method": 22, "name": "confirm", "args": { "title": "string", "message": "string?", "confirm": "string", "destructive": "bool?" }, "result": "{ok: bool}" },
      { "method": 23, "name": "prompt", "args": { "title": "string", "message": "string?", "initial": "string?", "placeholder": "string?", "confirm": "string", "keyboard": "enum keyboardType?", "mono": "bool?" }, "result": "{text: string|null}" },
      { "method": 24, "name": "focus", "args": { "node": "int", "focused": "bool" }, "result": "null" },
      { "method": 30, "name": "clipboardWrite", "args": { "text": "string" }, "result": "null" },
      { "method": 31, "name": "openUrl", "args": { "url": "string" }, "result": "{opened: bool}" },
      { "method": 32, "name": "share", "args": { "text": "string?", "title": "string?", "data": "string? (base64)", "mime": "string?", "filename": "string?" }, "result": "null" },
      { "method": 33, "name": "saveFile", "args": { "data": "string (base64)", "mime": "string", "filename": "string" }, "result": "{path: string}" },
      { "method": 40, "name": "storageGet", "args": { "key": "string" }, "result": "{value: json|null}" },
      { "method": 41, "name": "storageSet", "args": { "key": "string", "value": "json" }, "result": "null" },
      { "method": 42, "name": "storageRemove", "args": { "key": "string" }, "result": "null" },
      { "method": 43, "name": "storageKeys", "args": {}, "result": "{keys: string[]}" },
      { "method": 50, "name": "reportError", "args": { "message": "string", "stack": "string?", "fatal": "bool?" }, "result": "null" }
    ],
    "errorCodes": ["forbidden", "invalid", "unsupported", "quota", "not_connected", "connection_lost", "timeout", "function_not_found", "cancelled"],
    "errorDoc": "A failed request answers [8, reqId, 0, {code, message}]. Engine errors keep the engine's own code; the codes above are the host's.",
    "env": {
      "windowClass": ["compact", "wide"],
      "posture": ["flat", "tabletop", "book"],
      "platform": ["android", "ios", "ipados", "macos"],
      "visible": "bool",
      "theme": ["dark", "light"],
      "locale": "string (BCP 47)",
      "online": "bool"
    },
    "rootPage": "root"
  }
}
