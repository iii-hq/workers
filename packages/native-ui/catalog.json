{
  "catalogVersion": 2,
  "doc": "The canonical schema of the worker native UI (the iii app's catalogue and wire protocol). Tags, codes and enum indexes are append-only: never renumber, never reuse. The ide repo keeps a byte-identical copy at native/catalog/catalog.json, checked by a unit test. Design: ide/projects/worker-native-ui/design.md sections 5 and 6.",
  "encoding": {"current": "bin-v1", "reserved": [], "text": "json-v0", "doc": "The schema: every message is one array of entries, each entry an array whose first element is its integer code. VM to host: the SDK calls __host_send(entries) with the array itself; on a device the VM encodes it in C as bin-v1 (design §5.8: a generic tagged JSON-value encoding with a per-message string table, header byte 0xB1). json-v0 is the text form of the same schema (UTF-8 JSON, no BOM, no trailing newline): the test harness, the conformance files and debugging use it. Host to VM: json-v0 text through __vm_receive(string)."},
  "features": ["ops.json.v0", "list.splice.v1", "text.handshake.v1", "remote-screen.v1"],
  "limits": {
    "maxBundleBytes": 1048576,
    "bundleWarnBytes": 131072,
    "bundleFailBytes": 262144,
    "maxImageBytes": 524288,
    "maxListItems": 100000,
    "maxNodeId": 2147483647,
    "maxStorageKeyChars": 128,
    "maxStorageValueBytes": 65536,
    "maxStorageBytesPerWorker": 262144,
    "maxPendingHostEntries": 2000,
    "callTimeoutMsDefault": 30000,
    "callTimeoutMsMax": 120000,
    "heapBytesDefault": 67108864,
    "loadBudgetMs": 2000,
    "stepBudgetMs": 250,
    "maxMessageBytes": 8388608,
    "maxMarkdownChars": 200000
  },
  "valueTypes": {
    "bool": "JSON true or false.",
    "int": "JSON integer (32-bit signed).",
    "float": "JSON number.",
    "dp": "JSON number, density-independent pixels. For the common width and height props, -1 means fill the parent.",
    "string": "JSON string.",
    "icon": "JSON string: a Lucide icon name in kebab-case (globe, refresh-cw). An unknown name draws a neutral square and logs once.",
    "strings": "JSON array of strings.",
    "json": "Any JSON value.",
    "padding": "JSON number (all sides) | [vertical, horizontal] | [top, end, bottom, start], in dp.",
    "textWrite": "[text: string, eventCount: int]: a script write into an uncontrolled text field. The host applies it only when eventCount equals its own count of user edits (and never during IME composition); otherwise it drops it.",
    "enum": "JSON integer: the index into the named list of enums. An out-of-range index reads as the prop's default."
  },
  "binding": {
    "doc": "Inside a List template subtree (List slots 1 to 4), any prop value may be the object {\"$item\": \"field.path\"}: the host reads that dotted path of the item the template is drawn for. A missing field reads as the prop's default. Bindings are not allowed outside a template (the host treats them as the default and logs once).",
    "key": "$item"
  },
  "enums": {
    "crossAlign": ["start", "center", "end", "stretch"],
    "mainArrange": ["start", "center", "end", "spaceBetween", "spaceAround"],
    "boxAlign": ["topStart", "topCenter", "topEnd", "centerStart", "center", "centerEnd", "bottomStart", "bottomCenter", "bottomEnd"],
    "axis": ["vertical", "horizontal"],
    "textRole": ["body", "strong", "large", "small", "smallStrong", "micro", "heading", "title", "display", "code", "codeSmall", "id", "idSmall"],
    "tone": ["default", "secondary", "muted", "faint", "dim", "success", "warning", "danger", "accent", "attention"],
    "textAlign": ["start", "center", "end"],
    "overflow": ["end", "middle", "clip"],
    "badgeVariant": ["default", "ok", "warn", "alert", "accent"],
    "dotTone": ["ink", "ok", "warn", "alert", "accent"],
    "statusVariant": ["info", "success", "warn", "alert"],
    "buttonKind": ["secondary", "primary", "outline", "ghost", "destructive", "soft"],
    "keyboardType": ["text", "url", "search", "email", "number", "password"],
    "imeAction": ["default", "go", "search", "send", "done", "next"],
    "chipTone": ["neutral", "accent", "success", "warning", "danger"],
    "imageFit": ["contain", "cover"],
    "remoteMode": ["interact", "view"],
    "toastKind": ["info", "success", "error"],
    "hue": ["none", "blue", "purple", "teal", "green", "amber", "rose"]
  },
  "events": [
    { "tag": 1, "name": "press", "args": [], "doc": "A tap (or click, or Enter on a focused control)." },
    { "tag": 2, "name": "longPress", "args": [], "argsByType": {"RemoteScreen": ["x", "y"]}, "doc": "A long press, right-click or control-click. RemoteScreen sends [x, y] in page coordinates." },
    { "tag": 3, "name": "change", "args": ["value"], "doc": "Switch: [checked]. TextField: its edits arrive as text entries (host-to-VM code 4), not as events; subscribing to change turns them on." },
    { "tag": 4, "name": "submit", "args": ["text"], "doc": "TextField: the IME action or Enter, with the text at that moment." },
    { "tag": 5, "name": "select", "args": ["index"], "doc": "Segmented: the option chosen." },
    { "tag": 6, "name": "focus", "args": ["focused"], "doc": "TextField gained (true) or lost (false) the focus." },
    { "tag": 7, "name": "dismiss", "args": [], "doc": "Sheet closed by the person; ListDetail detail closed on compact (Back, the chevron, the side swipe)." },
    { "tag": 8, "name": "refresh", "args": [], "doc": "Pull to refresh (Scroll, List)." },
    { "tag": 9, "name": "endReached", "args": [], "doc": "List: the last 5 items came into view (fires once per item count)." },
    { "tag": 10, "name": "frame", "args": ["width", "height", "modeChanged"], "doc": "RemoteScreen: after every resize it applies (modeChanged = the resize's mode_changed), for the first frame after an activation (false), and when the page size of the frames changes (false, at most every 250 ms). Never per frame." },
    { "tag": 11, "name": "error", "args": ["message"], "doc": "RemoteScreen: the live view could not start, or stopped with an error." },
    { "tag": 12, "name": "keyboard", "args": ["open"], "doc": "RemoteScreen: the keyboard bar opened or closed by the person." },
    { "tag": 13, "name": "ready", "args": [], "doc": "RemoteScreen: the first frame of the current session is on screen." },
    { "tag": 14, "name": "link", "args": ["href"], "doc": "Markdown: a link was tapped, with its destination as written (a bare URL the autolinker found, too). The host never opens it: the script decides (iii.openUrl, nav.push)." },
    { "tag": 15, "name": "drop", "args": ["key", "index", "source"], "doc": "List with a dragGroup: an item was dropped on this List. key = the item's key field; index = where it goes among this List's items once it is out of its old place (0..count); source = the node id of the List it came from (this one for a reorder)." }
  ],
  "commonProps": [
    { "tag": 1, "name": "visible", "type": "bool", "default": true, "doc": "False: the node takes no space and is not drawn." },
    { "tag": 2, "name": "events", "type": "int", "default": 0, "doc": "Bitmask of subscribed events, bit (1 << event tag). The host only sends subscribed events and only enables the gestures behind them (no long-press haptic without longPress)." },
    { "tag": 3, "name": "testTag", "type": "string", "default": null, "doc": "Compose testTag / SwiftUI accessibilityIdentifier." },
    { "tag": 4, "name": "a11yLabel", "type": "string", "default": null, "doc": "Overrides what a screen reader says for the node." },
    { "tag": 5, "name": "weight", "type": "float", "default": 0, "doc": "In a Row or Column: share of the remaining space; 0 = none." },
    { "tag": 6, "name": "width", "type": "dp", "default": null, "doc": "null = the node's own size; -1 = fill the parent." },
    { "tag": 7, "name": "height", "type": "dp", "default": null, "doc": "null = the node's own size; -1 = fill the parent." },
    { "tag": 8, "name": "padding", "type": "padding", "default": 0 },
    { "tag": 9, "name": "alignSelf", "type": "enum", "enum": "crossAlign", "default": null, "doc": "Overrides the parent's cross-axis alignment for this child; null = the parent's." }
  ],
  "reservedCommonPropTags": [10, 11, 12, 13, 14, 15],
  "firstTypePropTag": 16,
