{
  "name": "text-handshake",
  "description": "The edit-count handshake: the script lower-cases each edit (written with the count it saw); then a trigger makes the script write \"filled\" with count 1 while the person had typed again (count 2): the host drops that write (see host.droppedWrites), the person's text reaches the script as the next text entry, and the script's answer with count 2 applies. Submit sends the host's text.",
  "catalog": 1,
  "encoding": "json-v0",
  "app": "conformance/apps/text-handshake.tsx",
  "ns": "demo",
  "toVm": [
    "[[1,{\"catalog\":1,\"features\":[\"ops.json.v0\",\"list.splice.v1\",\"text.handshake.v1\",\"remote-screen.v1\"],\"host\":\"android 0.1.0\",\"engine\":\"quickjs-ng 0.17.0\",\"app\":{\"key\":\"worker:demo\",\"ns\":\"demo\"},\"env\":{\"windowClass\":\"compact\",\"posture\":\"flat\",\"platform\":\"android\",\"visible\":true,\"theme\":\"dark\",\"locale\":\"en-US\",\"online\":true}}],[6,1,\"root\",{}]]",
    "[[8,1,1,null]]",
    "[[4,3,1,\"Ab\"]]",
    "[[9,1,{\"text\":\"filled\"}]]",
    "[[4,3,2,\"abC\"]]",
    "[[2,3,4,[\"abc\"]]]"
  ],
  "fromVm": [
    "[[23,{\"sdk\":\"0.1.0\",\"catalog\":1,\"features\":[\"ops.json.v0\",\"list.splice.v1\",\"text.handshake.v1\",\"remote-screen.v1\"],\"pages\":[{\"name\":\"root\",\"modal\":false,\"fullScreen\":false}]}]]",
    "[[1,1,40],[2,1,16,\"Form\"],[1,2,1],[2,2,16,8],[2,2,8,16],[1,3,22],[2,3,18,\"Name\"],[2,3,2,24],[2,3,3,\"name\"],[3,2,0,0,3],[1,4,10],[2,4,16,\"Nothing sent\"],[2,4,3,\"echo\"],[3,2,0,1,4],[3,1,0,0,2],[7,1,1],[20,1,2,{\"sub\":1,\"trigger\":\"demo::fill\",\"config\":{}}]]",
    "[[2,3,16,[\"ab\",1]]]",
    "[[2,3,16,[\"filled\",1]]]",
    "[[2,3,16,[\"abc\",2]]]",
    "[[2,4,16,\"Sent abc\"]]"
  ],
  "order": ["fromVm", "toVm", "fromVm", "toVm", "toVm", "fromVm", "toVm", "fromVm", "toVm", "fromVm", "toVm", "fromVm"],
  "tree": {
    "1": {
      "type": "Page",
      "id": 1,
      "props": {
        "title": "Form"
      },
      "slots": {
        "body": [
          {
            "type": "Column",
            "id": 2,
            "props": {
              "padding": 16,
              "gap": 8
            },
            "slots": {
              "children": [
                {
                  "type": "TextField",
                  "id": 3,
                  "props": {
                    "events": ["change", "submit"],
                    "testTag": "name",
                    "label": "Name",
                    "value": "abc"
                  }
                },
                {
                  "type": "Text",
                  "id": 4,
                  "props": {
                    "testTag": "echo",
                    "text": "Sent abc"
                  }
                }
              ]
            }
          }
        ]
      }
    }
  },
  "host": {
    "droppedWrites": [
      {
        "node": 3,
        "text": "filled",
        "count": 1,
        "hostCount": 2,
        "hostText": "abC"
      }
    ]
  }
}
