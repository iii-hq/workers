{
  "name": "@iii-dev/console-ui",
  "version": "0.1.0",
  "description": "Compile-time surface of the console's injectable-UI runtime module. Type-only by design: at runtime the console's import map serves the real module from the running SPA, so this package must stay `external` in every worker UI build — its js entry throws to make a forgotten external fail fast and loud.",
  "type": "module",
  "types": "./index.d.ts",
  "main": "./index.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./component-names": {
      "types": "./component-names.d.mts",
      "default": "./component-names.mjs"
    },
    "./token-names": {
      "types": "./token-names.d.mts",
      "default": "./token-names.mjs"
    },
    "./ui-classes": {
      "types": "./ui-classes.d.mts",
      "default": "./ui-classes.mjs"
    },
    "./configuration": {
      "types": "./configuration.d.mts",
      "default": "./configuration.mjs"
    },
    "./format": {
      "types": "./format.d.mts",
      "default": "./format.mjs"
    },
    "./hooks": {
      "types": "./hooks.d.mts",
      "default": "./hooks.mjs"
    },
    "./build-worker-ui": {
      "types": "./build-worker-ui.d.mts",
      "default": "./build-worker-ui.mjs"
    },
    "./lint-worker-ui": {
      "types": "./lint-worker-ui.d.mts",
      "default": "./lint-worker-ui.mjs"
    },
    "./tsconfig.worker-ui.json": "./tsconfig.worker-ui.json"
  },
  "files": [
    "index.d.ts",
    "index.js",
    "component-names.mjs",
    "component-names.d.mts",
    "token-names.mjs",
    "token-names.d.mts",
    "ui-classes.mjs",
    "ui-classes.d.mts",
    "configuration.mjs",
    "configuration.d.mts",
    "format.mjs",
    "format.d.mts",
    "hooks.mjs",
    "hooks.d.mts",
    "build-worker-ui.mjs",
    "build-worker-ui.d.mts",
    "lint-worker-ui.mjs",
    "lint-worker-ui.d.mts",
    "tsconfig.worker-ui.json"
  ],
  "devDependencies": {
    "@types/react": "catalog:",
    "esbuild": "catalog:",
    "react": "catalog:"
  },
  "peerDependencies": {
    "react": ">=19"
  }
}
