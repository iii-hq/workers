{
  "name": "claude-code",
  "version": "0.2.0",
  "private": true,
  "description": "Claude Code as an iii worker: headless turns over the iii bus and a terminal page on the console, both on one login. Raw messages on claude::events, AgentEvent frames on agent::events.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.18.2",
  "scripts": {
    "build": "npm run build:ui && tsc -b",
    "build:bundle": "npm run build:ui && node scripts/build-bundle.mjs",
    "typecheck": "npm run build:ui && tsc -b --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "build:ui": "node ui/build.mjs"
  },
  "bin": {
    "claude-code": "./dist/index.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.173",
    "@opentelemetry/api": "^1.9.1",
    "iii-sdk": "0.23.0-rc.2",
    "yaml": "^2.6.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.10",
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
