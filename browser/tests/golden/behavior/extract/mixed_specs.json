{
  "function": "browser::extract",
  "case": "mixed_specs",
  "request": {
    "html": "<html><head></head><body><h1 class=\"t\">Hello</h1><ul><li><a href=\"/a\">Apple</a></li><li><a href=\"/b\">Banana</a></li></ul><p>price 42 usd then 99</p></body></html>\n",
    "selectors": [
      {
        "name": "title",
        "css": "h1"
      },
      {
        "name": "links",
        "css": "li a",
        "attr": "href",
        "all": true
      },
      {
        "name": "names",
        "css": "li a",
        "all": true
      },
      {
        "name": "price",
        "regex": "price (\\d+)"
      },
      {
        "name": "first_li_html",
        "css": "li",
        "html": true
      }
    ]
  },
  "ok": {
    "extracted": {
      "title": "Hello",
      "links": [
        "/a",
        "/b"
      ],
      "names": [
        "Apple",
        "Banana"
      ],
      "price": "42",
      "first_li_html": "<li><a href=\"/a\">Apple</a></li>"
    }
  }
}
