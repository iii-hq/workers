{
  "function": "browser::extract",
  "case": "xpath_specs",
  "request": {
    "html": "<html><head></head><body><h1 class=\"t\">Hello</h1><ul><li><a href=\"/a\">Apple</a></li><li><a href=\"/b\">Banana</a></li></ul><p>price 42 usd then 99</p></body></html>\n",
    "selectors": [
      {
        "name": "first_link",
        "xpath": "//ul/li/a",
        "attr": "href"
      },
      {
        "name": "all_text",
        "xpath": "//li/a/text()",
        "all": true
      }
    ]
  },
  "ok": {
    "extracted": {
      "first_link": "/a",
      "all_text": [
        "Apple",
        "Banana"
      ]
    }
  }
}
