{
  "function_id": "browser::doctor",
  "description": "Read-only environment diagnostics: which Chromium the worker would launch, its version, session capacity, and any degraded capability with how to enable it. Never starts a browser.",
  "request_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "DoctorInput",
    "type": "object"
  },
  "response_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "DoctorOutput",
    "type": "object",
    "required": [
      "active_sessions",
      "allow_cookie_import",
      "allow_history_access",
      "allowed_schemes",
      "attach_enabled",
      "browser_running",
      "configured_origin_policies",
      "data_dir",
      "default_origin_policy_set",
      "headless_default",
      "issues",
      "max_sessions",
      "ok",
      "open_tabs",
      "recording_available"
    ],
    "properties": {
      "active_sessions": {
        "description": "Tabs with a page open right now.",
        "type": "integer",
        "format": "uint64",
        "minimum": 0.0
      },
      "allow_cookie_import": {
        "type": "boolean"
      },
      "allow_history_access": {
        "type": "boolean"
      },
      "allowed_schemes": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "attach_enabled": {
        "description": "Whether attach mode is enabled (allow_attach).",
        "type": "boolean"
      },
      "browser_running": {
        "description": "Whether the shared Chromium process is running.",
        "type": "boolean"
      },
      "chromium_path": {
        "type": [
          "string",
          "null"
        ]
      },
      "chromium_version": {
        "type": [
          "string",
          "null"
        ]
      },
      "configured_origin_policies": {
        "type": "integer",
        "format": "uint64",
        "minimum": 0.0
      },
      "data_dir": {
        "description": "Where the profile, downloads and tab list live.",
        "type": "string"
      },
      "default_origin_policy_set": {
        "type": "boolean"
      },
      "headless_default": {
        "type": "boolean"
      },
      "issues": {
        "type": "array",
        "items": {
          "$ref": "#/definitions/DoctorIssue"
        }
      },
      "max_sessions": {
        "description": "Live-tab cap (`max_sessions`).",
        "type": "integer",
        "format": "uint64",
        "minimum": 0.0
      },
      "ok": {
        "description": "True when sessions can start right now.",
        "type": "boolean"
      },
      "open_tabs": {
        "description": "Every tab, live or asleep.",
        "type": "integer",
        "format": "uint64",
        "minimum": 0.0
      },
      "recording_available": {
        "description": "Whether ffmpeg is on PATH, which browser::recording requires.",
        "type": "boolean"
      }
    },
    "definitions": {
      "DoctorIssue": {
        "description": "One degraded capability plus the way to enable it.",
        "type": "object",
        "required": [
          "enable_how",
          "what"
        ],
        "properties": {
          "enable_how": {
            "type": "string"
          },
          "what": {
            "type": "string"
          }
        }
      }
    }
  }
}
