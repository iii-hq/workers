{
  "function_id": "browser::find-by-text",
  "description": "Find elements whose visible text matches a string (exact or `partial`).",
  "request_schema": {
    "type": "object",
    "properties": {
      "html": {
        "type": "string"
      },
      "text": {
        "type": "string"
      },
      "partial": {
        "type": "boolean",
        "description": "match elements that contain the text"
      },
      "case_sensitive": {
        "type": "boolean"
      },
      "clean_match": {
        "type": "boolean",
        "description": "ignore surrounding/collapsing whitespace"
      },
      "first": {
        "type": "boolean"
      },
      "limit": {
        "type": "integer"
      }
    },
    "required": [
      "html",
      "text"
    ]
  },
  "response_schema": {
    "type": "object",
    "properties": {
      "count": {
        "type": "integer"
      },
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "tag": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "html": {
              "type": "string"
            },
            "attrs": {
              "type": "object"
            },
            "css": {
              "type": "string"
            },
            "xpath": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
