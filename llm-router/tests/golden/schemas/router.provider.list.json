{
  "description": "List registered providers with configuration, availability, catalog, and sanitized diagnostics.",
  "function_id": "router::provider::list",
  "request_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "description": "Input of `router::provider::list` — takes no arguments. A struct (rather than `Value`) keeps the request schema concrete; unknown fields (e.g. the engine-injected `_caller_worker_id`) are ignored.",
    "title": "ProviderListRequest",
    "type": "object"
  },
  "response_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "definitions": {
      "CatalogState": {
        "enum": [
          "unknown",
          "discovering",
          "ready",
          "empty",
          "error"
        ],
        "type": "string"
      },
      "CredentialRequirement": {
        "enum": [
          "required",
          "optional",
          "external"
        ],
        "type": "string"
      },
      "CredentialState": {
        "enum": [
          "unknown",
          "ready",
          "missing",
          "external"
        ],
        "type": "string"
      },
      "ErrorKind": {
        "enum": [
          "auth_expired",
          "rate_limited",
          "context_overflow",
          "transient",
          "permanent"
        ],
        "type": "string"
      },
      "ProviderDiagnostic": {
        "properties": {
          "catalog_state": {
            "$ref": "#/definitions/CatalogState"
          },
          "credential_state": {
            "$ref": "#/definitions/CredentialState"
          },
          "last_failure": {
            "anyOf": [
              {
                "$ref": "#/definitions/RouterFailure"
              },
              {
                "type": "null"
              }
            ]
          },
          "stale": {
            "description": "True after router restart until fresh provider/runtime evidence lands.",
            "type": "boolean"
          },
          "updated_at": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "catalog_state",
          "credential_state",
          "stale",
          "updated_at"
        ],
        "type": "object"
      },
      "ProviderInfo": {
        "properties": {
          "available": {
            "type": "boolean"
          },
          "configured": {
            "type": "boolean"
          },
          "credential_requirement": {
            "$ref": "#/definitions/CredentialRequirement"
          },
          "diagnostic": {
            "$ref": "#/definitions/ProviderDiagnostic"
          },
          "display_name": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "model_count": {
            "format": "uint",
            "minimum": 0.0,
            "type": "integer"
          },
          "supports_model_listing": {
            "type": "boolean"
          }
        },
        "required": [
          "available",
          "configured",
          "credential_requirement",
          "diagnostic",
          "display_name",
          "id",
          "model_count",
          "supports_model_listing"
        ],
        "type": "object"
      },
      "RouterFailure": {
        "description": "Stable machine-readable failure returned by router surfaces and terminal assistant messages. Legacy fields remain populated for compatibility.",
        "properties": {
          "attempts": {
            "format": "uint32",
            "minimum": 0.0,
            "type": "integer"
          },
          "code": {
            "type": "string"
          },
          "kind": {
            "$ref": "#/definitions/ErrorKind"
          },
          "message": {
            "type": "string"
          },
          "model": {
            "type": [
              "string",
              "null"
            ]
          },
          "provider": {
            "type": [
              "string",
              "null"
            ]
          },
          "retryable": {
            "type": "boolean"
          }
        },
        "required": [
          "attempts",
          "code",
          "kind",
          "message",
          "retryable"
        ],
        "type": "object"
      }
    },
    "properties": {
      "providers": {
        "items": {
          "$ref": "#/definitions/ProviderInfo"
        },
        "type": "array"
      }
    },
    "required": [
      "providers"
    ],
    "title": "ProviderListResponse",
    "type": "object"
  }
}
