{
  "description": "Kill a tmux window and every program running in its panes.",
  "function_id": "tmux::windows::kill",
  "request_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "definitions": {
      "WindowArg": {
        "anyOf": [
          {
            "description": "Window index inside the session.",
            "format": "uint32",
            "minimum": 0.0,
            "type": "integer"
          },
          {
            "description": "Window id like `@3`, or an index as text.",
            "type": "string"
          }
        ],
        "description": "A window as callers name it: an id (`\"@3\"`) or an index (`2` or `\"2\"`)."
      }
    },
    "properties": {
      "session": {
        "description": "Session id (`$5`) or exact name.",
        "type": "string"
      },
      "window": {
        "allOf": [
          {
            "$ref": "#/definitions/WindowArg"
          }
        ],
        "description": "Window id (`@3`) or index."
      }
    },
    "required": [
      "session",
      "window"
    ],
    "title": "WindowInput",
    "type": "object"
  },
  "response_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "properties": {
      "killed": {
        "description": "Always true.",
        "type": "boolean"
      }
    },
    "required": [
      "killed"
    ],
    "title": "KilledOutput",
    "type": "object"
  }
}
