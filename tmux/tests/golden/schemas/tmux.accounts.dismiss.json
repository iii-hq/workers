  "request_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "properties": {
      "suggestion": {
        "description": "The suggestion's `id`.",
        "type": "string"
      }
    },
    "required": [
      "suggestion"
    ],
    "title": "DismissInput",
    "type": "object"
  },
  "response_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "description": "Nothing to return.",
    "title": "EmptyOutput",
    "type": "object"
  }
}
