#!/bin/bash
# claude-state <pane> working|waiting|idle|limit [HH:MM]
# Tells the fake Claude Code in tmux pane <pane> (e.g. %3) what to show.
set -euo pipefail
# Only ever inside the demo container (demo/Dockerfile sets DEMO_CONTAINER=1):
# on a host this would write to the real home folder or talk to its tmux.
if [[ ! -f /.dockerenv || "${DEMO_CONTAINER:-}" != 1 ]]; then
  echo "$(basename "$0") runs only inside the demo container" >&2; exit 2
fi
pane=${1:?pane id like %3}; state=${2:?working, waiting, idle or limit}; at=${3:-}
case "$state" in working|waiting|idle|limit) ;; *) echo "unknown state $state" >&2; exit 2;; esac
root=$(tmux display -p -t "$pane" '#{pane_pid}')
for pid in "$root" $(pgrep -P "$root" || true); do
  if tr '\0' ' ' </proc/"$pid"/cmdline 2>/dev/null | grep -q '/usr/local/bin/claude'; then
    printf '%s %s\n' "$state" "$at" >/tmp/fake-claude/"$pid".state
    echo "pane $pane (pid $pid): $state $at"
    exit 0
  fi
done
echo "no fake claude in pane $pane" >&2; exit 1
