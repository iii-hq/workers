{
  "description": "Watch a PR via authenticated webhooks until merged/closed or an explicit expiry.",
  "function_id": "github::pr::watch",
  "request_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "definitions": {
      "Category": {
        "enum": [
          "ci",
          "comments",
          "reviews",
          "pr"
        ],
        "type": "string"
      },
      "StopOn": {
        "enum": [
          "merged",
          "closed"
        ],
        "type": "string"
      }
    },
    "properties": {
      "events": {
        "description": "Omitted means all four categories; empty means lifecycle notifications only.",
        "items": {
          "$ref": "#/definitions/Category"
        },
        "type": [
          "array",
          "null"
        ],
        "uniqueItems": true
      },
      "expires_at": {
        "description": "Required absolute RFC3339 expiry; leases never outlive this deadline.",
        "format": "date-time",
        "type": "string"
      },
      "number": {
        "format": "uint64",
        "minimum": 1.0,
        "type": [
          "integer",
          "null"
        ]
      },
      "pr_url": {
        "description": "HTTPS github.com/owner/repo/pull/number, exclusive with repo + number.",
        "type": [
          "string",
          "null"
        ]
      },
      "repo": {
        "type": [
          "string",
          "null"
        ]
      },
      "stop_on": {
        "allOf": [
          {
            "$ref": "#/definitions/StopOn"
          }
        ],
        "default": "merged"
      },
      "watch_id": {
        "description": "Stable caller-selected identifier. Arm the event trigger before calling watch.",
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9_.:-]+$",
        "type": "string"
      }
    },
    "required": [
      "expires_at",
      "watch_id"
    ],
    "title": "WatchRequest",
    "type": "object"
  },
  "response_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "definitions": {
      "CiEntity": {
        "properties": {
          "attempt": {
            "format": "uint64",
            "minimum": 0.0,
            "type": "integer"
          },
          "conclusion": {
            "type": [
              "string",
              "null"
            ]
          },
          "html_url": {
            "default": null,
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "default": null,
            "description": "Human-readable check/workflow name or commit-status context.",
            "type": [
              "string",
              "null"
            ]
          },
          "sha": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "updated_at": {
            "type": "string"
          }
        },
        "required": [
          "attempt",
          "sha",
          "status",
          "updated_at"
        ],
        "type": "object"
      },
      "Health": {
        "properties": {
          "cleanup_attempts": {
            "format": "uint32",
            "minimum": 0.0,
            "type": "integer"
          },
          "delivery_guarantee": {
            "description": "Quick Tunnels can lose ingress during outages. Redelivery is bounded by GitHub retention.",
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "hook_ready": {
            "type": "boolean"
          },
          "last_error": {
            "type": [
              "string",
              "null"
            ]
          },
          "pending_jobs": {
            "format": "uint",
            "minimum": 0.0,
            "type": "integer"
          },
          "tunnel_status": {
            "type": "string"
          }
        },
        "required": [
          "cleanup_attempts",
          "delivery_guarantee",
          "enabled",
          "hook_ready",
          "pending_jobs",
          "tunnel_status"
        ],
        "type": "object"
      },
      "Snapshot": {
        "properties": {
          "ci": {
            "additionalProperties": {
              "$ref": "#/definitions/CiEntity"
            },
            "description": "CI is per-entity, never an aggregate success inferred from one check.",
            "type": "object"
          },
          "head_sha": {
            "type": [
              "string",
              "null"
            ]
          },
          "merged": {
            "type": "boolean"
          },
          "state": {
            "type": [
              "string",
              "null"
            ]
          },
          "updated_at": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "ci",
          "merged"
        ],
        "type": "object"
      },
      "WatchState": {
        "enum": [
          "preparing",
          "active",
          "completed",
          "expired",
          "stopped",
          "cleanup_pending"
        ],
        "type": "string"
      }
    },
    "properties": {
      "health": {
        "$ref": "#/definitions/Health"
      },
      "number": {
        "format": "uint64",
        "minimum": 0.0,
        "type": "integer"
      },
      "repo": {
        "type": "string"
      },
      "snapshot": {
        "$ref": "#/definitions/Snapshot"
      },
      "status": {
        "$ref": "#/definitions/WatchState"
      },
      "watch_id": {
        "type": "string"
      }
    },
    "required": [
      "health",
      "number",
      "repo",
      "snapshot",
      "status",
      "watch_id"
    ],
    "title": "WatchResponse",
    "type": "object"
  }
}
