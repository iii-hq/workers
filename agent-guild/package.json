{
  "name": "agent-guild",
  "version": "0.1.0",
  "private": true,
  "description": "Optional public endpoint observations and supplied public passport verification for iii.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@10.9.3",
  "exports": {
    ".": {
      "types": "./dist/types/worker.d.ts",
      "import": "./dist/lib/worker.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-bundle.mjs",
    "build:bundle": "npm run build",
    "start": "node dist/bundle/index.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "biome ci .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:e2e": "node tests/e2e/run.mjs"
  },
  "dependencies": {
    "iii-sdk": "0.23.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.10",
    "@types/node": "22.10.0",
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  }
}
