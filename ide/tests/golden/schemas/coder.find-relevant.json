{
  "description": "Find the code relevant to a behavioural question (how, why or where something works, even one naming a function or setting): walks folders then files asking the judge yes/no relevance questions and returns files best first. Start behavioural discovery here before broad text searches; for exact symbols, strings or filenames use coder::search. Set path to the folder of the component the question is about (e.g. judge/src): time and judge cost grow with the folder, and a repository-root ask on a large repo hits the judge token budget. Read the returned files before searching again. incomplete = partial coverage (see reason and issues; narrow path); unavailable = no judge, use coder::search. Sends the query, root-relative paths and file text to the session's judge provider, which may be hosted: never protected, ignored, hidden, .git or secret-named files, nor the text of binary or secret-key files. A path that is hidden, gitignored or outside a project folder is refused. Paths: relative to the primary root or absolute inside an allowed root (see coder::info).",
  "function_id": "coder::find-relevant",
  "request_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "examples": [
      {
        "path": "harness/src",
        "query": "where does the harness stamp the filesystem scope on coder calls?"
      }
    ],
    "properties": {
      "exclude_globs": {
        "default": [],
        "description": "Globs (not gitignore lines) to leave out, relative to the session root like coder::search's, NOT to `path`: with path `ade`, write `ade/gen/**` or `**/gen/**`. `gen/` or `gen/**` drops the folder itself. They only narrow.",
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "path": {
        "default": ".",
        "description": "Folder to search (default `.`); result paths are absolute.",
        "type": "string"
      },
      "query": {
        "description": "Behavioural question in natural language: how, why or where something works (1..=4000 bytes).",
        "type": "string"
      },
      "timeout_ms": {
        "default": 240000,
        "description": "Deadline for the whole ask in ms; work left at the deadline makes the result `incomplete`.",
        "format": "uint64",
        "maximum": 280000.0,
        "minimum": 1000.0,
        "type": "integer"
      }
    },
    "required": [
      "query"
    ],
    "title": "FindRelevantInput",
    "type": "object"
  },
  "response_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "definitions": {
      "ByteSpan": {
        "description": "UTF-8 byte offsets in the file: `[byte_from, byte_to)`.",
        "properties": {
          "byte_from": {
            "format": "uint32",
            "minimum": 0.0,
            "type": "integer"
          },
          "byte_to": {
            "format": "uint32",
            "minimum": 0.0,
            "type": "integer"
          }
        },
        "required": [
          "byte_from",
          "byte_to"
        ],
        "type": "object"
      },
      "CallLead": {
        "properties": {
          "caller": {
            "description": "The selected declaration making the call.",
            "type": "string"
          },
          "line_from": {
            "format": "uint32",
            "minimum": 0.0,
            "type": "integer"
          },
          "line_to": {
            "format": "uint32",
            "minimum": 0.0,
            "type": "integer"
          },
          "name": {
            "description": "The called method.",
            "type": "string"
          },
          "unknown_earlier_bases": {
            "description": "Earlier bases in the resolution order that were not inspected.",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "caller",
          "line_from",
          "line_to",
          "name",
          "unknown_earlier_bases"
        ],
        "type": "object"
      },
      "Excerpt": {
        "properties": {
          "line_from": {
            "format": "uint32",
            "minimum": 0.0,
            "type": "integer"
          },
          "line_to": {
            "format": "uint32",
            "minimum": 0.0,
            "type": "integer"
          },
          "partial": {
            "anyOf": [
              {
                "$ref": "#/definitions/ByteSpan"
              },
              {
                "type": "null"
              }
            ],
            "description": "Present when `text` is only a byte span of its lines (for example inside a line over 24000 bytes): do not rewrite whole lines from it."
          },
          "text": {
            "description": "Verbatim source of the line range; with `partial`, only that byte span of it.",
            "type": "string"
          }
        },
        "required": [
          "line_from",
          "line_to",
          "text"
        ],
        "type": "object"
      },
      "Lead": {
        "properties": {
          "line_from": {
            "format": "uint32",
            "minimum": 0.0,
            "type": "integer"
          },
          "line_to": {
            "format": "uint32",
            "minimum": 0.0,
            "type": "integer"
          },
          "name": {
            "description": "Declaration name.",
            "type": "string"
          },
          "score": {
            "format": "double",
            "type": "number"
          }
        },
        "required": [
          "line_from",
          "line_to",
          "name",
          "score"
        ],
        "type": "object"
      },
      "RelevantFile": {
        "properties": {
          "call_leads": {
            "description": "Possible local calls from the shown source (not runtime-verified).",
            "items": {
              "$ref": "#/definitions/CallLead"
            },
            "type": "array"
          },
          "excerpts": {
            "items": {
              "$ref": "#/definitions/Excerpt"
            },
            "type": "array"
          },
          "leads": {
            "description": "Declarations worth reading whose source is not shown.",
            "items": {
              "$ref": "#/definitions/Lead"
            },
            "type": "array"
          },
          "path": {
            "description": "Absolute path.",
            "type": "string"
          },
          "priority": {
            "description": "Judge's read-early priority in [0, 1], when assessed.",
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "roles": {
            "description": "Estimated roles: implementation, caller, test, fixture, helper.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "score": {
            "description": "Navigation score in [0, 1].",
            "format": "double",
            "type": "number"
          },
          "source_omitted": {
            "description": "Some source was left out (output budget or the file changed); its locations remain.",
            "type": "boolean"
          }
        },
        "required": [
          "call_leads",
          "excerpts",
          "leads",
          "path",
          "roles",
          "score",
          "source_omitted"
        ],
        "type": "object"
      },
      "Stats": {
        "properties": {
          "cache_hits": {
            "format": "uint64",
            "minimum": 0.0,
            "type": "integer"
          },
          "elapsed_ms": {
            "format": "uint64",
            "minimum": 0.0,
            "type": "integer"
          },
          "input_tokens": {
            "format": "uint64",
            "minimum": 0.0,
            "type": "integer"
          },
          "judge_calls": {
            "format": "uint64",
            "minimum": 0.0,
            "type": "integer"
          },
          "questions": {
            "format": "uint64",
            "minimum": 0.0,
            "type": "integer"
          }
        },
        "required": [
          "cache_hits",
          "elapsed_ms",
          "input_tokens",
          "judge_calls",
          "questions"
        ],
        "type": "object"
      },
      "Status": {
        "oneOf": [
          {
            "description": "Every admitted branch was explored.",
            "enum": [
              "complete"
            ],
            "type": "string"
          },
          {
            "description": "Partial coverage (deadline, judge token budget, a failed or oversized request, a resource limit): see `reason` and `issues`; narrow `path` and retry.",
            "enum": [
              "incomplete"
            ],
            "type": "string"
          },
          {
            "description": "No judge answered; use coder::search.",
            "enum": [
              "unavailable"
            ],
            "type": "string"
          }
        ]
      }
    },
    "properties": {
      "agents_md": {
        "description": "AGENTS.md files from the project folder down to `path`, and above returned files.",
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "files": {
        "description": "Best first.",
        "items": {
          "$ref": "#/definitions/RelevantFile"
        },
        "type": "array"
      },
      "issues": {
        "additionalProperties": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "description": "Coverage issues by kind.",
        "type": "object"
      },
      "reason": {
        "description": "Why the result is not complete.",
        "type": [
          "string",
          "null"
        ]
      },
      "stats": {
        "$ref": "#/definitions/Stats"
      },
      "status": {
        "$ref": "#/definitions/Status"
      }
    },
    "required": [
      "agents_md",
      "files",
      "issues",
      "stats",
      "status"
    ],
    "title": "FindRelevantOutput",
    "type": "object"
  }
}
