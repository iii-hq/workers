{
  "name": "vscode",
  "version": "0.1.0",
  "private": true,
  "description": "Actual Microsoft VS Code Workbench and official VS Code Server as an injectable iii Console worker.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.18.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "build": "pnpm --dir ui build && node scripts/build-bundle.mjs",
    "build:bundle": "node scripts/build-bundle.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --dir ui typecheck",
    "test": "vitest run",
    "start": "node dist/bundle/index.mjs",
    "dev": "tsx src/index.ts"
  },
  "dependencies": {
    "iii-sdk": "0.23.0-rc.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.9.2",
    "vitest": "^3.0.0"
  }
}
