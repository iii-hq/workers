{
  "description": "The cloud plan for a commit plus the fast checks here; with run: true, also the run here. Without manifest it checks the file the work is on: the newest check's of this environment if it named one and the environment's file is unchanged since, else the environment's own. manifest checks another worker-compose*.yaml instead, changing nothing in iii cloud. push: true pushes the workspace's fix branch first, never an environment's branch.",
  "function_id": "iii-cloud::check",
  "request_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "description": "`iii-cloud::check` input.",
    "properties": {
      "commit": {
        "default": null,
        "description": "Default: the workspace's `HEAD`.",
        "type": [
          "string",
          "null"
        ]
      },
      "force": {
        "default": null,
        "description": "With `run`: run again even when a passed run of the same commit, compose file, engine and run environment exists.",
        "type": [
          "boolean",
          "null"
        ]
      },
      "from_page": {
        "default": false,
        "description": "The page's own: a check the person started on the page. When the hand-off's agent waits on a wake, it hears what is left for it. Agents never send it.",
        "type": "boolean"
      },
      "handoff_id": {
        "default": null,
        "description": "An agent works on its own hand-off: use that one's environment and worktree.",
        "type": [
          "string",
          "null"
        ]
      },
      "manifest": {
        "default": null,
        "description": "Check another `worker-compose*.yaml` of the repository (from its root) instead of the environment's. Nothing changes in iii cloud: the environment switches to it only when the person deploys this check. Default: the hand-off's file, else the environment's.",
        "type": [
          "string",
          "null"
        ]
      },
      "push": {
        "default": null,
        "description": "Push the workspace's fix branch first (`--force-with-lease`), so the cloud can plan its head. `PUSH_REFUSED` for a branch an environment tracks or that is not an `iii-cloud/` fix branch.",
        "type": [
          "boolean",
          "null"
        ]
      },
      "run": {
        "default": null,
        "description": "Also run the app here the way the cloud runs it.",
        "type": [
          "boolean",
          "null"
        ]
      }
    },
    "title": "CheckRequest",
    "type": "object"
  },
  "response_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "definitions": {
      "CommitLine": {
        "properties": {
          "message": {
            "description": "The subject line.",
            "type": "string"
          },
          "sha": {
            "type": "string"
          }
        },
        "required": [
          "message",
          "sha"
        ],
        "type": "object"
      },
      "Confirmations": {
        "properties": {
          "overrides": {
            "items": {
              "$ref": "#/definitions/OverrideConfirmation"
            },
            "type": "array"
          },
          "resources": {
            "items": {
              "$ref": "#/definitions/ResourceConfirmation"
            },
            "type": "array"
          }
        },
        "required": [
          "overrides",
          "resources"
        ],
        "type": "object"
      },
      "Excerpt": {
        "properties": {
          "lines": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "start_line": {
            "format": "uint32",
            "minimum": 0.0,
            "type": "integer"
          }
        },
        "required": [
          "lines",
          "start_line"
        ],
        "type": "object"
      },
      "HealthResult": {
        "properties": {
          "path": {
            "type": "string"
          },
          "status": {
            "format": "uint16",
            "minimum": 0.0,
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "path"
        ],
        "type": "object"
      },
      "HerePart": {
        "properties": {
          "accepts_cloud_block": {
            "type": "boolean"
          },
          "iii_version": {
            "type": [
              "string",
              "null"
            ]
          },
          "problems": {
            "format": "uint32",
            "minimum": 0.0,
            "type": "integer"
          }
        },
        "required": [
          "accepts_cloud_block",
          "problems"
        ],
        "type": "object"
      },
      "OverrideConfirmation": {
        "properties": {
          "console": true,
          "file": true,
          "setting": {
            "type": "string"
          }
        },
        "required": [
          "console",
          "file",
          "setting"
        ],
        "type": "object"
      },
      "Owner": {
        "oneOf": [
          {
            "enum": [
              "agent",
              "person"
            ],
            "type": "string"
          },
          {
            "description": "Info only: nothing to do.",
            "enum": [
              "none"
            ],
            "type": "string"
          }
        ]
      },
      "PlanPart": {
        "properties": {
          "at_least": {
            "description": "The plan stops at its first blocking step: more may follow.",
            "type": "boolean"
          },
          "blocking": {
            "format": "uint32",
            "minimum": 0.0,
            "type": "integer"
          },
          "confirmations": {
            "$ref": "#/definitions/Confirmations"
          },
          "digest": {
            "type": [
              "string",
              "null"
            ]
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/definitions/WorkerError"
              },
              {
                "type": "null"
              }
            ]
          },
          "fingerprint": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "$ref": "#/definitions/PlanStatus"
          },
          "summary": {
            "anyOf": [
              {
                "$ref": "#/definitions/PlanSummary"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "What the plan runs: its workers and machine groups. Null without a plan."
          },
          "warnings": {
            "format": "uint32",
            "minimum": 0.0,
            "type": "integer"
          },
          "web_candidates": true
        },
        "required": [
          "at_least",
          "blocking",
          "confirmations",
          "status",
          "warnings"
        ],
        "type": "object"
      },
      "PlanStatus": {
        "enum": [
          "clean",
          "blocked",
          "not_pushed",
          "commit_not_planned",
          "unavailable"
        ],
        "type": "string"
      },
      "PlanSummary": {
        "properties": {
          "groups": {
            "description": "The groups' names, in the plan's order.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "workers": {
            "format": "uint32",
            "minimum": 0.0,
            "type": "integer"
          }
        },
        "required": [
          "groups",
          "workers"
        ],
        "type": "object"
      },
      "Problem": {
        "properties": {
          "cloud_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "code": {
            "type": "string"
          },
          "detail": {
            "type": [
              "string",
              "null"
            ]
          },
          "excerpt": {
            "anyOf": [
              {
                "$ref": "#/definitions/Excerpt"
              },
              {
                "type": "null"
              }
            ]
          },
          "file": {
            "type": [
              "string",
              "null"
            ]
          },
          "fix": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "description": "sha1(source, code, file, line), stable across checks.",
            "type": "string"
          },
          "line": {
            "format": "uint32",
            "minimum": 0.0,
            "type": [
              "integer",
              "null"
            ]
          },
          "owner": {
            "$ref": "#/definitions/Owner"
          },
          "severity": {
            "$ref": "#/definitions/Severity"
          },
          "skipped": {
            "description": "The person skipped its name for now (`values::skip`). `EMPTY_DEFAULT_VARIABLE` then has severity `info`; `SECRET_MISSING` stays `block`.",
            "type": "boolean"
          },
          "source": {
            "$ref": "#/definitions/Source"
          },
          "title": {
            "type": "string"
          },
          "variable": {
            "description": "The variable a value problem is about (`SECRET_MISSING`, `EMPTY_DEFAULT_VARIABLE`, `LOCAL_VARIABLE_UNSET`), as the problem itself knows it.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "code",
          "id",
          "owner",
          "severity",
          "source",
          "title"
        ],
        "type": "object"
      },
      "ResourceConfirmation": {
        "properties": {
          "alias": {
            "type": "string"
          },
          "binding": {
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "type": "string"
          },
          "tier": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "alias",
          "kind"
        ],
        "type": "object"
      },
      "RouteCount": {
        "properties": {
          "count": {
            "format": "uint32",
            "minimum": 0.0,
            "type": "integer"
          },
          "prefix": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "count"
        ],
        "type": "object"
      },
      "Run": {
        "properties": {
          "check_id": {
            "type": "string"
          },
          "commit": {
            "type": "string"
          },
          "engine": {
            "type": "string"
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/definitions/RunError"
              },
              {
                "type": "null"
              }
            ]
          },
          "finished_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "healthcheck": {
            "anyOf": [
              {
                "$ref": "#/definitions/HealthResult"
              },
              {
                "type": "null"
              }
            ]
          },
          "id": {
            "type": "string"
          },
          "left_redacted": {
            "default": false,
            "description": "The copies under this run's `left/` were written with the run's secret values replaced. Absent (an older run): `check::read` refuses its kept files.",
            "type": "boolean"
          },
          "log_path": {
            "default": null,
            "description": "The run's whole redacted log, an absolute path (`log_tail` is only its last 40 lines).",
            "type": [
              "string",
              "null"
            ]
          },
          "log_tail": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "moved": {
            "default": [],
            "description": "The untracked files the run created, moved out of the copy into the run's `left/` folder when it ended (at most 500).",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "not_covered": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "restored": {
            "default": [],
            "description": "The tracked files the run rewrote and the worker put back as committed when it ended (at most 500; their rewritten versions are kept in the run's `left/` folder).",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "reused": {
            "default": false,
            "description": "A passed run of an earlier check answered this one: nothing ran again.",
            "type": "boolean"
          },
          "routes": {
            "$ref": "#/definitions/RouteCount"
          },
          "stages": {
            "items": {
              "$ref": "#/definitions/Stage"
            },
            "type": "array"
          },
          "started_at": {
            "type": "string"
          },
          "status": {
            "$ref": "#/definitions/RunStatus"
          },
          "waiting_on": {
            "anyOf": [
              {
                "$ref": "#/definitions/WaitingOn"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "The workers stage has gone a minute with no new worker: who it waits for. The run is still `running`; null otherwise."
          },
          "workers": {
            "$ref": "#/definitions/WorkerCount"
          }
        },
        "required": [
          "check_id",
          "commit",
          "engine",
          "id",
          "log_tail",
          "not_covered",
          "routes",
          "stages",
          "started_at",
          "status",
          "workers"
        ],
        "type": "object"
      },
      "RunError": {
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "owner": {
            "anyOf": [
              {
                "$ref": "#/definitions/RunOwner"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Whose the failure is (`run_code_owner`): the agent fixes it, the person must, or the run was cut short. Set whenever the check is stored."
          },
          "stage": {
            "$ref": "#/definitions/StageName"
          },
          "withheld": {
            "default": false,
            "description": "The worker would not send this failure to the agent now: the person has a blocking problem open (a missing value fails the run too), so it is theirs first.",
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message",
          "stage"
        ],
        "type": "object"
      },
      "RunOwner": {
        "description": "Who a failed local run's code belongs to.",
        "oneOf": [
          {
            "description": "A newer run of the workspace replaced this one: nothing to fix and nothing to send (the newer run is judged in its turn).",
            "enum": [
              "replaced"
            ],
            "type": "string"
          },
          {
            "description": "The agent fixes it in the worktree.",
            "enum": [
              "agent"
            ],
            "type": "string"
          },
          {
            "description": "The person's: Docker, a tool, the iii binary, or a decision about the routes.",
            "enum": [
              "person"
            ],
            "type": "string"
          },
          {
            "description": "Nobody's fault: the run was cut short; run it again.",
            "enum": [
              "interrupted"
            ],
            "type": "string"
          }
        ]
      },
      "RunStatus": {
        "enum": [
          "running",
          "passed",
          "failed"
        ],
        "type": "string"
      },
      "Severity": {
        "enum": [
          "block",
          "warn",
          "info"
        ],
        "type": "string"
      },
      "Source": {
        "enum": [
          "cloud_plan",
          "check_here"
        ],
        "type": "string"
      },
      "Stage": {
        "properties": {
          "detail": {
            "type": [
              "string",
              "null"
            ]
          },
          "duration_ms": {
            "format": "uint64",
            "minimum": 0.0,
            "type": [
              "integer",
              "null"
            ]
          },
          "name": {
            "$ref": "#/definitions/StageName"
          },
          "status": {
            "$ref": "#/definitions/StageStatus"
          }
        },
        "required": [
          "name",
          "status"
        ],
        "type": "object"
      },
      "StageName": {
        "enum": [
          "install",
          "build",
          "release",
          "compose_up",
          "workers",
          "routes",
          "healthcheck"
        ],
        "type": "string"
      },
      "StageStatus": {
        "enum": [
          "pending",
          "running",
          "passed",
          "failed",
          "skipped"
        ],
        "type": "string"
      },
      "WaitingOn": {
        "properties": {
          "containers": {
            "description": "The containers that have not connected.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "since": {
            "description": "When the wait was noticed (RFC 3339).",
            "type": "string"
          }
        },
        "required": [
          "containers",
          "since"
        ],
        "type": "object"
      },
      "WorkerCount": {
        "properties": {
          "ready": {
            "format": "uint32",
            "minimum": 0.0,
            "type": "integer"
          },
          "total": {
            "format": "uint32",
            "minimum": 0.0,
            "type": "integer"
          }
        },
        "required": [
          "ready",
          "total"
        ],
        "type": "object"
      },
      "WorkerError": {
        "description": "`{code, message, status?, fix?}` inside records.",
        "properties": {
          "code": {
            "type": "string"
          },
          "fix": {
            "type": [
              "string",
              "null"
            ]
          },
          "message": {
            "type": "string"
          },
          "status": {
            "format": "uint16",
            "minimum": 0.0,
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      }
    },
    "properties": {
      "base": {
        "description": "The environment branch's head when checked.",
        "type": "string"
      },
      "checked_at": {
        "type": "string"
      },
      "commit": {
        "type": "string"
      },
      "commits": {
        "default": [],
        "description": "The commits of `base..commit`, newest first, at most 50. Empty when the base was not read or the commit is not on this machine.",
        "items": {
          "$ref": "#/definitions/CommitLine"
        },
        "type": "array"
      },
      "duration_ms": {
        "format": "uint64",
        "minimum": 0.0,
        "type": "integer"
      },
      "environment_id": {
        "type": "string"
      },
      "handoff_id": {
        "default": null,
        "description": "The hand-off whose agent asked for it; null for the page's own checks.",
        "type": [
          "string",
          "null"
        ]
      },
      "here": {
        "$ref": "#/definitions/HerePart"
      },
      "id": {
        "type": "string"
      },
      "manifest": {
        "default": null,
        "description": "The compose file it was checked with, from the repository root. When it is not the environment's, deploying this check switches the environment to it.",
        "type": [
          "string",
          "null"
        ]
      },
      "plan": {
        "$ref": "#/definitions/PlanPart"
      },
      "problems": {
        "description": "Cloud plan first, then the checks here.",
        "items": {
          "$ref": "#/definitions/Problem"
        },
        "type": "array"
      },
      "ready": {
        "type": "boolean"
      },
      "report": {
        "type": "string"
      },
      "run": {
        "anyOf": [
          {
            "$ref": "#/definitions/Run"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "base",
      "checked_at",
      "commit",
      "duration_ms",
      "environment_id",
      "here",
      "id",
      "plan",
      "problems",
      "ready",
      "report"
    ],
    "title": "Check",
    "type": "object"
  }
}
