{
  "description": "Ask the person for a secret value on the page, or mark a name as not needed or their decision.",
  "function_id": "iii-cloud::secret",
  "request_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "definitions": {
      "SecretMode": {
        "enum": [
          "ask",
          "not_needed",
          "decide"
        ],
        "type": "string"
      }
    },
    "description": "`iii-cloud::secret` input.",
    "properties": {
      "description": {
        "description": "What the person needs to know to give the value.",
        "type": "string"
      },
      "external": {
        "default": null,
        "description": "The person chose a database outside iii cloud: only then may a database URL be asked for.",
        "type": [
          "boolean",
          "null"
        ]
      },
      "handoff_id": {
        "default": null,
        "type": [
          "string",
          "null"
        ]
      },
      "mode": {
        "anyOf": [
          {
            "$ref": "#/definitions/SecretMode"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "name": {
        "description": "`^[A-Z_][A-Z0-9_]*$`, not starting with `III_`.",
        "type": "string"
      }
    },
    "required": [
      "description",
      "name"
    ],
    "title": "SecretAsk",
    "type": "object"
  },
  "response_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "definitions": {
      "CloudOutcome": {
        "enum": [
          "set",
          "skipped",
          "failed"
        ],
        "type": "string"
      },
      "EnvironmentInfo": {
        "properties": {
          "branch": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "manifest": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string"
          },
          "production": {
            "type": "boolean"
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "branch",
          "id",
          "name",
          "production"
        ],
        "type": "object"
      },
      "LocalOutcome": {
        "enum": [
          "set",
          "skipped"
        ],
        "type": "string"
      },
      "SecretMode": {
        "enum": [
          "ask",
          "not_needed",
          "decide"
        ],
        "type": "string"
      },
      "SecretState": {
        "enum": [
          "waiting",
          "set",
          "left_empty",
          "noted",
          "failed"
        ],
        "type": "string"
      },
      "Selected": {
        "properties": {
          "env": {
            "$ref": "#/definitions/EnvironmentInfo"
          },
          "team_id": {
            "type": "string"
          },
          "workspace": {
            "type": "string"
          }
        },
        "required": [
          "env",
          "team_id",
          "workspace"
        ],
        "type": "object"
      },
      "WorkerError": {
        "description": "`{code, message, status?, fix?}` inside records.",
        "properties": {
          "code": {
            "type": "string"
          },
          "fix": {
            "type": [
              "string",
              "null"
            ]
          },
          "message": {
            "type": "string"
          },
          "status": {
            "format": "uint16",
            "minimum": 0.0,
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      }
    },
    "properties": {
      "asked_at": {
        "type": "string"
      },
      "cloud": {
        "anyOf": [
          {
            "$ref": "#/definitions/CloudOutcome"
          },
          {
            "type": "null"
          }
        ]
      },
      "description": {
        "type": "string"
      },
      "environment_id": {
        "type": "string"
      },
      "error": {
        "anyOf": [
          {
            "$ref": "#/definitions/WorkerError"
          },
          {
            "type": "null"
          }
        ]
      },
      "external": {
        "default": false,
        "description": "Asked for a database URL the person chose to keep outside iii cloud.",
        "type": "boolean"
      },
      "id": {
        "type": "string"
      },
      "local": {
        "anyOf": [
          {
            "$ref": "#/definitions/LocalOutcome"
          },
          {
            "type": "null"
          }
        ]
      },
      "mode": {
        "$ref": "#/definitions/SecretMode"
      },
      "name": {
        "type": "string"
      },
      "resolved_at": {
        "type": [
          "string",
          "null"
        ]
      },
      "state": {
        "$ref": "#/definitions/SecretState"
      },
      "target": {
        "anyOf": [
          {
            "$ref": "#/definitions/Selected"
          },
          {
            "type": "null"
          }
        ],
        "description": "Where the value goes: the team, worktree and environment the request was asked for, whatever the page has selected when the value is saved."
      }
    },
    "required": [
      "asked_at",
      "description",
      "environment_id",
      "id",
      "mode",
      "name",
      "state"
    ],
    "title": "SecretRequest",
    "type": "object"
  }
}
