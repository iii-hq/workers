      },
      "ValuesFrom": {
        "description": "Where `iii-cloud::values` reads the compose file.",
        "oneOf": [
          {
            "description": "The selected workspace (the worktree, or the checkout in \"edits this folder\").",
            "enum": [
              "workspace"
            ],
            "type": "string"
          },
          {
            "description": "The person's checkout.",
            "enum": [
