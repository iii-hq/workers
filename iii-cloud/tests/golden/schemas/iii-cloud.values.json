            "enum": [
              "workspace"
            ],
            "type": "string"
          },
          {
            "description": "The person's checkout.",
            "enum": [
              "checkout"
            ],
            "type": "string"
          }
        ]
      }
    },
    "description": "`iii-cloud::values` input.",
