{
  "description": "Text to speech on Sarvam Bulbul behind router::speak: text, a speaker name and a language in, base64 audio out (mp3, wav, pcm16, opus).",
  "function_id": "provider::sarvam::speak",
  "request_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "properties": {
      "format": {
        "default": null,
        "description": "`mp3` (default), `wav`, `pcm16`, `opus`.",
        "type": [
          "string",
          "null"
        ]
      },
      "language": {
        "default": null,
        "description": "Language of the text (`hi`, `hi-IN`, ...); English when omitted.",
        "type": [
          "string",
          "null"
        ]
      },
      "model": {
        "default": null,
        "description": "Text-to-speech model id; `bulbul:v3` when omitted.",
        "type": [
          "string",
          "null"
        ]
      },
      "speed": {
        "default": null,
        "description": "Speaking-rate multiplier, 0.5 to 2.0; 1.0 is the voice's own pace.",
        "format": "double",
        "type": [
          "number",
          "null"
        ]
      },
      "text": {
        "description": "Text to speak, up to 2500 characters. Write Indic words in their own script for natural speech.",
        "type": "string"
      },
      "voice": {
        "default": null,
        "description": "Speaker name (`shubh`, `shreya`, `manan`, `ishita`, ...; the v2 voices `anushka`, `abhilash`, ... only with `bulbul:v2`).",
        "type": [
          "string",
          "null"
        ]
      }
    },
    "required": [
      "text"
    ],
    "title": "SpeakRequest",
    "type": "object"
  },
  "response_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "properties": {
      "audio_base64": {
        "type": "string"
      },
      "mime": {
        "type": "string"
      },
      "model": {
        "type": "string"
      },
      "voice": {
        "description": "The speaker used.",
        "type": "string"
      }
    },
    "required": [
      "audio_base64",
      "mime",
      "model",
      "voice"
    ],
    "title": "SpeakResponse",
    "type": "object"
  }
}
