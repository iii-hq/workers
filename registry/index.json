    "auth-credentials": {
      "type": "binary",
      "description": "Provider credential vault under auth::* \u2014 API keys and OAuth tokens",
      "repo": "iii-hq/workers",
      "tag_prefix": "auth-credentials",
      "supported_targets": [
        "aarch64-apple-darwin",
        "x86_64-unknown-linux-gnu"
      ],
      "has_checksum": true,
      "default_config": {
        "threshold_pct": 0.85,
        "fallback_context_window": 200000
      },
      "version": "0.1.0"
    },
