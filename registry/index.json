{
  "version": 1,
  "workers": {
    "acp": {
      "type": "binary",
      "description": "Agent Client Protocol surface — stdio JSON-RPC, exposes iii agents as ACP sessions",
      "repo": "iii-hq/workers",
      "tag_prefix": "acp",
      "supported_targets": [
        "aarch64-apple-darwin",
        "x86_64-unknown-linux-gnu"
      ],
      "has_checksum": true,
      "default_config": {},
      "version": "0.1.0"
    },
    "approval-gate": {
      "type": "binary",
      "description": "Hook subscriber on agent::before_function_call that pauses function calls listed in approval_required until the UI resolves them via approval::resolve.",
      "repo": "iii-hq/workers",
      "tag_prefix": "approval-gate",
      "supported_targets": [
        "aarch64-apple-darwin",
        "x86_64-unknown-linux-gnu"
      ],
      "has_checksum": true,
      "default_config": {
        "topic": "agent::before_function_call",
        "approval_state_scope": "approvals",
        "default_timeout_ms": 300000
      },
      "version": "0.1.0"
    },
    "auth-credentials": {
      "type": "binary",
      "description": "Provider credential vault under auth::* — API keys and OAuth tokens.",
      "repo": "iii-hq/workers",
      "tag_prefix": "auth-credentials",
      "supported_targets": [
        "aarch64-apple-darwin",
        "x86_64-unknown-linux-gnu"
      ],
      "has_checksum": true,
      "default_config": {
        "threshold_pct": 0.85,
        "fallback_context_window": 200000
      },
      "version": "0.1.0"
    },
    "harness": {
      "type": "binary",
