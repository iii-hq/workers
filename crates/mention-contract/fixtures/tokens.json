        { "name": "kanban", "id": "2", "token": "@kanban(id=\"2\")" }
      ]
    },
    {
      "name": "double-backtick code holding a single backtick",
      "prose": true,
      "text": "``a ` @kanban(id=\"1\")`` @kanban(id=\"2\")",
      "mentions": [
        { "name": "kanban", "id": "2", "token": "@kanban(id=\"2\")" }
      ]
    },
    {
      "name": "an unmatched backtick is text",
      "prose": true,
      "text": "a ` b @kanban(id=\"3\")",
      "mentions": [
        { "name": "kanban", "id": "3", "token": "@kanban(id=\"3\")" }
      ]
    }
  ],
  "format": [
    { "name": "kanban", "id": "6ac4f6df-ec84-83e9-b480-4b54b9931ce0", "token": "@kanban(id=\"6ac4f6df-ec84-83e9-b480-4b54b9931ce0\")" },
    { "name": "kanban", "id": "a\"b\\c", "token": "@kanban(id=\"a\\\"b\\\\c\")" },
