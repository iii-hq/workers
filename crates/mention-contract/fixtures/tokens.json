{
  "_comment": "Shared token-grammar cases: crates/mention-contract (Rust) and ade/web/src/lib/mentions/token.ts (TypeScript) both run every case. `prose: true` runs the code-skipping parser.",
  "parse": [
    {
      "name": "plain token in prose",
      "text": "see @kanban(id=\"6ac4f6df-ec84-83e9-b480-4b54b9931ce0\") please",
      "mentions": [
        { "name": "kanban", "id": "6ac4f6df-ec84-83e9-b480-4b54b9931ce0", "token": "@kanban(id=\"6ac4f6df-ec84-83e9-b480-4b54b9931ce0\")" }
      ]
    },
    {
      "name": "several, digits and dashes in the name",
      "text": "@session(id=\"s_1\") and @my-worker2(id=\"x\")",
      "mentions": [
        { "name": "session", "id": "s_1", "token": "@session(id=\"s_1\")" },
        { "name": "my-worker2", "id": "x", "token": "@my-worker2(id=\"x\")" }
      ]
    },
    {
      "name": "escaped quote and backslash",
      "text": "@kanban(id=\"a\\\"b\\\\c\")",
      "mentions": [
        { "name": "kanban", "id": "a\"b\\c", "token": "@kanban(id=\"a\\\"b\\\\c\")" }
      ]
    },
    {
      "name": "unicode escape",
      "text": "@kanban(id=\"\\u00e9t\\u00e9\")",
      "mentions": [
        { "name": "kanban", "id": "été", "token": "@kanban(id=\"\\u00e9t\\u00e9\")" }
      ]
    },
    {
      "name": "non-ascii id",
      "text": "x @cal(id=\"réunion-1\") y",
      "mentions": [
        { "name": "cal", "id": "réunion-1", "token": "@cal(id=\"réunion-1\")" }
      ]
    },
    {
      "name": "inside parentheses",
      "text": "(@kanban(id=\"1\"))",
      "mentions": [
        { "name": "kanban", "id": "1", "token": "@kanban(id=\"1\")" }
      ]
    },
    {
      "name": "trailing punctuation",
      "text": "done: @kanban(id=\"1\").",
      "mentions": [
        { "name": "kanban", "id": "1", "token": "@kanban(id=\"1\")" }
      ]
    },
    {
      "name": "adjacent tokens",
      "text": "@a(id=\"1\")@b(id=\"2\")",
      "mentions": [
        { "name": "a", "id": "1", "token": "@a(id=\"1\")" },
        { "name": "b", "id": "2", "token": "@b(id=\"2\")" }
      ]
    },
    {
      "name": "after a newline",
      "text": "line\n@trace(id=\"ab12\")",
      "mentions": [
        { "name": "trace", "id": "ab12", "token": "@trace(id=\"ab12\")" }
      ]
    },
    {
      "name": "follows a word character",
      "text": "me@kanban(id=\"1\") and x_@kanban(id=\"2\")",
      "mentions": []
    },
    {
      "name": "reserved names",
      "text": "@fn(id=\"x\") @file(id=\"y\") @skill(id=\"z\") @fn(shell::exec)",
      "mentions": []
    },
    { "name": "uppercase name", "text": "@Kanban(id=\"1\")", "mentions": [] },
    { "name": "name starting with a digit", "text": "@1x(id=\"1\")", "mentions": [] },
    { "name": "unquoted id", "text": "@kanban(id=1)", "mentions": [] },
    { "name": "empty id", "text": "@kanban(id=\"\")", "mentions": [] },
    { "name": "unterminated", "text": "@kanban(id=\"abc", "mentions": [] },
    { "name": "extra arguments", "text": "@kanban(id=\"1\", x=\"2\")", "mentions": [] },
    { "name": "scoped search text", "text": "@kanban:login", "mentions": [] },
    { "name": "function id search text", "text": "@kanban::ticket::get", "mentions": [] },
    { "name": "bad escape", "text": "@kanban(id=\"a\\qb\")", "mentions": [] },
    {
      "name": "a missing closing quote is tolerated (models drop it)",
      "text": "In @session(id=\"console-9db3a777), titled \"hello\":",
      "mentions": [
        { "name": "session", "id": "console-9db3a777", "token": "@session(id=\"console-9db3a777)" }
      ]
    },
    { "name": "the tolerated form takes no quote or escape", "text": "@kanban(id=\"a\\\"b) @kanban(id=\"a\\b)", "mentions": [] },
    { "name": "the tolerated form takes no empty id", "text": "@kanban(id=\")", "mentions": [] },
    { "name": "raw control character", "text": "@kanban(id=\"a\nb\")", "mentions": [] },
    {
      "name": "skips inline code",
      "prose": true,
      "text": "`@kanban(id=\"1\")` and @kanban(id=\"2\")",
