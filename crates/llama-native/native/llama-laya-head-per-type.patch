llama.cpp b11379 runs laya's decision head once per question type (choice,
score, noul) on every token, because the type is not a graph input: 6 head
block passes per forward where the reference runs 2, which made judge-laya
16-25% slower on the CPU than its candle head. With decision orders in the
batch (llama_batch_ext_set_decision_order, every token of a row carrying its
question's order), the head adds each token's type embedding and runs once;
its score fills all three columns, so readers of a type's column are
unchanged. A batch without orders keeps the per-type head. Upstream: not
filed yet.

--- a/src/models/modern-bert.cpp
+++ b/src/models/modern-bert.cpp
@@ -1,8 +1,43 @@
 #include "models.h"
 
+#include "llama-ext.h"
+
 // question types of a decision model: choice, score, noul
 static const uint32_t N_DECISION_TYPES = 3;
 
+// The question type of each token, from the batch's decision orders (llama_batch_ext_set_decision_order: every
+// token of a row carries its question's order), so the decision head runs once instead of once per type. A batch
+// without orders keeps the per-type head.
+class llm_graph_input_decision_types : public llm_graph_input_i {
+public:
+    explicit llm_graph_input_decision_types(const llama_ubatch & ubatch) :
+        n_tokens(ubatch.n_tokens), has_orders(ubatch.decision_order != nullptr) {}
+
+    void set_input(const llama_ubatch * ubatch) override {
+        if (!types) {
+            return;
+        }
+        std::vector<int32_t> data(n_tokens);
+        for (int64_t i = 0; i < n_tokens; ++i) {
+            switch (ubatch->decision_order[i]) {
+                case LLAMA_DECISION_ORDER_QUESTION_SCORE: data[i] = 1; break;
+                case LLAMA_DECISION_ORDER_QUESTION_NOUL:  data[i] = 2; break;
+                default:                                  data[i] = 0; break; // choice
+            }
+        }
+        ggml_backend_tensor_set(types, data.data(), 0, ggml_nbytes(types));
+    }
+
+    bool can_reuse(const llm_graph_params & params) override {
+        return params.ubatch.n_tokens == n_tokens && (params.ubatch.decision_order != nullptr) == has_orders;
+    }
+
+    ggml_tensor * types = nullptr; // I32 [n_tokens], the type embedding row of each token
+
+    const int64_t n_tokens;
+    const bool    has_orders;
+};
+
