{
  "name": "learn-iii",
  "version": "0.2.0",
  "private": true,
  "description": "Guided console tour: step content, progress in state, and a spotlight over the console.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "build": "pnpm run build:bundle",
    "build:assets": "cd ui && node build.mjs",
    "build:bundle": "pnpm run build:ui && node scripts/build-bundle.mjs",
    "build:ui": "pnpm --dir .. --filter @iii-workers/learn-iii-ui... install --frozen-lockfile && pnpm --dir .. --filter @iii-workers/learn-iii-ui run build",
    "check": "node --check src/index.mjs && node --check src/tours.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "start": "node dist/bundle/index.mjs"
  },
  "dependencies": {
    "iii-sdk": "0.24.6"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
