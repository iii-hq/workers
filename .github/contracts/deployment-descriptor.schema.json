{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/iii-hq/workers/.github/contracts/deployment-descriptor.schema.json",
  "title": "Workers deployment descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "worker",
    "package_manifest_version",
    "source_sha",
    "deployment_spec_sha256",
    "public_manifest_sha256",
    "registry_projection_sha256",
    "compiler_digest",
    "descriptor_sha256",
    "source",
    "artifact",
    "runtime",
    "publish",
    "build_units",
    "registry_projection"
  ],
  "properties": {
    "contract": {"const": "deployment-descriptor"},
    "worker": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "package_manifest_version": {"type": "string", "minLength": 1},
    "source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "deployment_spec_sha256": {"$ref": "#/$defs/sha256"},
    "public_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "registry_projection_sha256": {"$ref": "#/$defs/sha256"},
    "compiler_digest": {"$ref": "#/$defs/sha256"},
    "descriptor_sha256": {"$ref": "#/$defs/sha256"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "package_manifest"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "package_manifest": {"enum": ["Cargo.toml", "package.json", "pyproject.toml"]}
      }
    },
    "artifact": {
      "oneOf": [
        {"$ref": "#/$defs/rustArtifact"},
        {"$ref": "#/$defs/bundleArtifact"},
        {"$ref": "#/$defs/ociArtifact"}
      ]
    },
    "runtime": {"type": "object"},
    "publish": {"type": "boolean"},
    "build_units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["rust-binary", "javascript-bundle", "python-bundle", "oci-image"]},
          "target": {"type": "string"},
          "platform": {"type": "string"}
        }
      }
    },
    "registry_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["worker_name", "type", "description", "license", "tags", "dependencies", "config", "experimental", "readme"],
      "properties": {
        "worker_name": {"type": "string", "minLength": 1},
        "type": {"enum": ["binary", "bundle", "image"]},
        "description": {"type": "string"},
        "license": {"type": "string"},
        "tags": {"type": "array", "items": {"type": "string"}},
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version"],
            "properties": {"name": {"type": "string"}, "version": {"type": "string"}}
          }
        },
        "config": {"type": "object"},
        "experimental": {"type": "boolean"},
        "readme": {"type": "string"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identityVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "argv": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "frontend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace_root", "source_path", "runtime", "package_manager", "lockfile", "install_command", "build_command", "outputs"],
      "properties": {
        "workspace_root": {"type": "string", "minLength": 1},
        "source_path": {"type": "string", "minLength": 1},
        "runtime": {"$ref": "#/$defs/identityVersion"},
        "package_manager": {"$ref": "#/$defs/identityVersion"},
        "lockfile": {"type": "string", "minLength": 1},
        "install_command": {"$ref": "#/$defs/argv"},
        "build_command": {"$ref": "#/$defs/argv"},
        "outputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "rustArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "toolchain", "binary", "targets"],
      "properties": {
        "kind": {"const": "rust-binary"},
        "toolchain": {"$ref": "#/$defs/identityVersion"},
        "binary": {"type": "string", "minLength": 1},
        "targets": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "windows_exception": {"type": "string", "minLength": 1},
        "frontends": {"type": "array", "items": {"$ref": "#/$defs/frontend"}}
      }
    },
    "bundleArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "workspace_root", "runtime", "package_manager", "lockfile", "install_command", "build_command", "include"],
      "properties": {
        "kind": {"enum": ["javascript-bundle", "python-bundle"]},
        "workspace_root": {"type": "string", "minLength": 1},
        "runtime": {"$ref": "#/$defs/identityVersion"},
        "package_manager": {"$ref": "#/$defs/identityVersion"},
        "lockfile": {"type": "string", "minLength": 1},
        "install_command": {"$ref": "#/$defs/argv"},
        "build_command": {"$ref": "#/$defs/argv"},
        "include": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "ociArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "context", "dockerfile", "platforms"],
      "properties": {
        "kind": {"const": "oci-image"},
        "context": {"type": "string", "minLength": 1},
        "dockerfile": {"type": "string", "minLength": 1},
        "platforms": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "platform_exception": {"const": true}
      }
    }
  }
}
