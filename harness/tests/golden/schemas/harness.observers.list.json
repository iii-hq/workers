{
  "function_id": "harness::observers::list",
  "request_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "properties": {
      "session_id": {
        "default": null,
        "description": "Owner session whose observers to list; in-turn calls may omit it (the calling session is injected).",
        "type": [
          "string",
          "null"
        ]
      }
    },
    "title": "ObserversListRequest",
    "type": "object"
  },
  "response_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "definitions": {
      "ConditionSpec": {
        "description": "One declared condition. Evaluated at fire time with the typed decision contract; ordinary iii functions, so a barrier or a claim is just a function someone wrote.",
        "properties": {
          "config": true,
          "function_id": {
            "type": "string"
          }
        },
        "required": [
          "function_id"
        ],
        "type": "object"
      },
      "ObserverRow": {
        "description": "One binding, as data. `function_id`, `args` and `filters` are what its observer observes.",
        "properties": {
          "action": {
            "description": "Human-readable event text declared as `action`.",
            "type": [
              "string",
              "null"
            ]
          },
          "args": true,
          "conditions": {
            "items": {
              "$ref": "#/definitions/ConditionSpec"
            },
            "type": "array"
          },
          "created_at": {
            "format": "int64",
            "type": "integer"
          },
          "expires_at": {
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "filters": true,
          "fires": {
            "format": "uint64",
            "minimum": 0.0,
            "type": "integer"
          },
          "function_id": {
            "description": "The observed function.",
            "type": [
              "string",
              "null"
            ]
          },
          "label": {
            "type": [
              "string",
              "null"
            ]
          },
          "max_fires": {
            "format": "uint64",
            "minimum": 0.0,
            "type": [
              "integer",
              "null"
            ]
          },
          "namespace": {
            "description": "Where the observed function is hosted, when the observer names it.",
            "type": [
              "string",
              "null"
            ]
          },
          "observer_id": {
            "type": "string"
          },
          "once": {
            "type": "boolean"
          },
          "target": {
            "description": "The function a delivery calls. Absent for a wake — the delivery notifies the owner session.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "created_at",
          "fires",
          "observer_id",
          "once"
        ],
        "type": "object"
      }
    },
    "properties": {
      "observers": {
        "items": {
          "$ref": "#/definitions/ObserverRow"
        },
        "type": "array"
      }
    },
    "required": [
      "observers"
    ],
    "title": "ObserversListResponse",
    "type": "object"
  }
}
