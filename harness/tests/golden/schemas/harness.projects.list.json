{
  "function_id": "harness::projects::list",
  "request_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "properties": {
      "version": {
        "default": null,
        "description": "`2` lists the chat projects. Without it, the saved-folder catalogue in its pre-projects shape (deprecated).",
        "format": "uint32",
        "minimum": 0.0,
        "type": [
          "integer",
          "null"
        ]
      }
    },
    "title": "ProjectsListRequest",
    "type": "object"
  },
  "response_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "anyOf": [
      {
        "$ref": "#/definitions/ProjectsListV2"
      },
      {
        "$ref": "#/definitions/LegacyFolderList"
      }
    ],
    "definitions": {
      "LegacyFolderList": {
        "description": "The saved folders, as `harness::projects::list` answered before projects.",
        "properties": {
          "projects": {
            "items": {
              "$ref": "#/definitions/SavedFolder"
            },
            "type": "array"
          }
        },
        "required": [
          "projects"
        ],
        "type": "object"
      },
      "Project": {
        "description": "One project.",
        "properties": {
          "account": {
            "additionalProperties": true,
            "default": {
              "mode": "global"
            },
            "description": "The project's Claude Code account (phase 4); `{mode: \"global\"}` until then. Kept whole, whatever fields it carries.",
            "type": "object"
          },
          "autocompact": {
            "additionalProperties": true,
            "default": {
              "mode": "inherit"
            },
            "description": "The project's autocompact setting (phase 3); `{mode: \"inherit\"}` until then. Kept whole, whatever fields it carries.",
            "type": "object"
          },
          "color": {
            "description": "One of `blue`, `purple`, `teal`, `green`, `amber`, `rose`.",
            "type": "string"
          },
          "created_at_ms": {
            "format": "int64",
            "type": "integer"
          },
          "folders": {
            "description": "1-20 absolute, normalised folders on the engine's computer.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "id": {
            "description": "`prj_` + a ULID, made by the server.",
            "type": "string"
          },
          "name": {
            "description": "1-40 characters, trimmed, unique on the engine without regard to case.",
            "type": "string"
          },
          "updated_at_ms": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "color",
          "created_at_ms",
          "folders",
          "id",
          "name",
          "updated_at_ms"
        ],
        "type": "object"
      },
      "ProjectsListV2": {
        "properties": {
          "projects": {
            "items": {
              "$ref": "#/definitions/Project"
            },
            "type": "array"
          },
          "revision": {
            "description": "Goes up on every change of the store.",
            "format": "uint64",
            "minimum": 0.0,
            "type": "integer"
          },
          "version": {
            "description": "Always 2.",
            "format": "uint32",
            "minimum": 0.0,
            "type": "integer"
          }
        },
        "required": [
          "projects",
          "revision",
          "version"
        ],
        "type": "object"
      },
      "SavedFolder": {
        "description": "One saved folder.",
        "properties": {
          "last_used_at": {
            "format": "int64",
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        },
        "required": [
          "last_used_at",
          "name",
          "path"
        ],
        "type": "object"
      }
    },
    "title": "ProjectsListResponse"
  }
}
