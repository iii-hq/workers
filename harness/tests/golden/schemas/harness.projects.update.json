{
  "function_id": "harness::projects::update",
  "request_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "properties": {
      "account": {
        "additionalProperties": true,
        "default": null,
        "description": "Phase 4: `{mode: \"global\"}` or a pinned account.",
        "type": [
          "object",
          "null"
        ]
      },
      "autocompact": {
        "additionalProperties": true,
        "default": null,
        "description": "Phase 3: `{mode: \"inherit\" | \"tokens\" | \"off\", tokens?}`.",
        "type": [
          "object",
          "null"
        ]
      },
      "bring_existing": {
        "default": null,
        "description": "Bring the conversations in the folders this call adds.",
        "type": [
          "boolean",
          "null"
        ]
      },
      "color": {
        "default": null,
        "type": [
          "string",
          "null"
        ]
      },
      "folders": {
        "default": null,
        "description": "The whole new folder list.",
        "items": {
          "type": "string"
        },
        "type": [
          "array",
          "null"
        ]
      },
      "id": {
        "type": "string"
      },
      "name": {
        "default": null,
        "type": [
          "string",
          "null"
        ]
      }
    },
    "required": [
      "id"
    ],
    "title": "ProjectUpdateRequest",
    "type": "object"
  },
  "response_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "definitions": {
      "Project": {
        "description": "One project.",
        "properties": {
          "account": {
            "additionalProperties": true,
            "default": {
              "mode": "global"
            },
            "description": "The project's Claude Code account (phase 4); `{mode: \"global\"}` until then. Kept whole, whatever fields it carries.",
            "type": "object"
          },
          "autocompact": {
            "additionalProperties": true,
            "default": {
              "mode": "inherit"
            },
            "description": "The project's autocompact setting (phase 3); `{mode: \"inherit\"}` until then. Kept whole, whatever fields it carries.",
            "type": "object"
          },
          "color": {
            "description": "One of `blue`, `purple`, `teal`, `green`, `amber`, `rose`.",
            "type": "string"
          },
          "created_at_ms": {
            "format": "int64",
            "type": "integer"
          },
          "folders": {
            "description": "1-20 absolute, normalised folders on the engine's computer.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "id": {
            "description": "`prj_` + a ULID, made by the server.",
            "type": "string"
          },
          "name": {
            "description": "1-40 characters, trimmed, unique on the engine without regard to case.",
            "type": "string"
          },
          "updated_at_ms": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "color",
          "created_at_ms",
          "folders",
          "id",
          "name",
          "updated_at_ms"
        ],
        "type": "object"
      }
    },
    "properties": {
      "moved": {
        "description": "Conversations `bring_existing` stamped.",
        "format": "uint64",
        "minimum": 0.0,
        "type": "integer"
      },
      "project": {
        "$ref": "#/definitions/Project"
      }
    },
    "required": [
      "moved",
      "project"
    ],
    "title": "ProjectWriteResponse",
    "type": "object"
  }
}
