          "timestamp"
        ],
        "type": "object"
      },
      "AssistantRoleTag": {
        "enum": [
          "assistant"
        ],
        "type": "string"
      },
      "ContentBlock": {
        "oneOf": [
          {
            "properties": {
              "text": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "text"
                ],
