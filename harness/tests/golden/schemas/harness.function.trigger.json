            "required": [
              "data",
              "mime",
              "type"
            ],
            "type": "object"
          },
          {
            "properties": {
              "signature": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "text": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "thinking"
                ],
