          "arguments": true,
          "function_id": {
            "description": "The iii function to invoke (already unwrapped from `agent_trigger`).",
            "type": "string"
          },
          "id": {
            "description": "function_call id, echoed into the result.",
            "type": "string"
          }
        },
        "required": [
          "arguments",
          "function_id",
          "id"
        ],
        "type": "object"
      }
    },
    "properties": {
      "call": {
        "$ref": "#/definitions/TriggerCall"
      },
      "session_id": {
        "type": "string"
      }
    },
    "required": [
      "call",
      "session_id"
    ],
    "title": "FunctionTriggerRequest",
    "type": "object"
  },
