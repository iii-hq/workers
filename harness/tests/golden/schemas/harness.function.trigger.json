              },
              "id": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "function_call"
                ],
                "type": "string"
              }
            },
            "required": [
              "arguments",
              "function_id",
              "id",
              "type"
            ],
            "type": "object"
          },
          {
            "properties": {
