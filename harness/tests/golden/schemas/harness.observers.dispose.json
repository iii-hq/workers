{
  "function_id": "harness::observers::dispose",
  "request_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "properties": {
      "observer_id": {
        "description": "The observer to remove (`id` is accepted as an alias).",
        "type": "string"
      },
      "session_id": {
        "default": null,
        "description": "The observer's owner session; in-turn calls may omit it (the calling session is injected).",
        "type": [
          "string",
          "null"
        ]
      }
    },
    "required": [
      "observer_id"
    ],
    "title": "ObserversDisposeRequest",
    "type": "object"
  },
  "response_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "properties": {
      "removed": {
        "description": "False when no record existed (already removed) — honest, not an error.",
        "type": "boolean"
      }
    },
    "required": [
      "removed"
    ],
    "title": "ObserversDisposeResponse",
    "type": "object"
  }
}
