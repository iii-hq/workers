{
  "function_id": "harness::ask",
  "request_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "definitions": {
      "AskAbout": {
        "properties": {
          "blocks": {
            "description": "Cards whose work waits on this answer.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "class": {
            "allOf": [
              {
                "$ref": "#/definitions/AskClass"
              }
            ],
            "default": "scope",
            "description": "The decision class used to derive urgency."
          },
          "ticket": {
            "description": "The card this question concerns.",
            "type": [
              "string",
              "null"
            ]
          },
          "why": {
            "description": "One paragraph explaining why the answer is needed.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "AskClass": {
        "enum": [
          "security",
          "publish",
          "external_cost",
          "data",
          "scope",
          "run_health",
          "routine"
        ],
        "type": "string"
      },
      "AskExpiry": {
        "anyOf": [
          {
            "properties": {
              "answer": {
                "type": "string"
              }
            },
            "required": [
              "answer"
            ],
            "type": "object"
          },
          {
            "$ref": "#/definitions/AskExpiryBlock"
          }
        ]
      },
      "AskExpiryBlock": {
        "enum": [
          "block"
        ],
        "type": "string"
      },
      "AskOption": {
        "properties": {
          "description": {
            "description": "Optional one-line explanation shown under the label.",
            "type": [
              "string",
              "null"
            ]
          },
          "label": {
            "description": "The choice as the user sees and sends it, 1-80 characters, unique within its question.",
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "recommended": {
            "description": "Marks the agent's preferred choice. At most one option per question.",
            "type": "boolean"
          }
        },
        "required": [
          "label"
        ],
        "type": "object"
      },
      "AskQuestion": {
        "properties": {
          "header": {
            "description": "Short chip label such as `Approach`; prefixes the answer line (`Approach: <label>`). No length limit: the card shows a long one with an ellipsis and the whole text on hover.",
            "minLength": 1,
            "type": "string"
          },
          "multi_select": {
            "default": false,
            "description": "Let the user pick several options (checkboxes) instead of one.",
            "type": "boolean"
          },
          "options": {
            "description": "2-4 discrete choices; do not add an \"Other\" option, the UI adds a free-text one.",
            "items": {
              "$ref": "#/definitions/AskOption"
            },
            "maxItems": 4,
            "minItems": 2,
            "type": "array"
          },
          "question": {
            "description": "The full question text shown above the options.",
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "header",
          "options",
          "question"
        ],
        "type": "object"
      }
    },
    "properties": {
      "about": {
        "allOf": [
          {
            "$ref": "#/definitions/AskAbout"
          }
        ],
        "description": "What this decision concerns and what it blocks."
      },
      "expires_in_min": {
        "description": "Minutes until the expiry action runs. Omitted asks wait forever.",
        "format": "uint64",
        "minimum": 0.0,
        "type": [
          "integer",
          "null"
        ]
      },
      "on_expiry": {
        "allOf": [
          {
            "$ref": "#/definitions/AskExpiry"
          }
        ],
        "description": "What to do at expiry. Defaults to leaving the question open and telling the agent that it must not decide for the user."
      },
      "questions": {
        "description": "1-4 questions shown together on one card; the answer arrives as the user's next message, one line per question.",
        "items": {
          "$ref": "#/definitions/AskQuestion"
        },
        "maxItems": 4,
        "minItems": 1,
        "type": "array"
      }
    },
    "required": [
      "questions"
    ],
    "title": "AskRequest",
    "type": "object"
  },
  "response_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "definitions": {
      "AskAbout": {
        "properties": {
          "blocks": {
            "description": "Cards whose work waits on this answer.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "class": {
            "allOf": [
              {
                "$ref": "#/definitions/AskClass"
              }
            ],
            "default": "scope",
            "description": "The decision class used to derive urgency."
          },
          "ticket": {
            "description": "The card this question concerns.",
            "type": [
              "string",
              "null"
            ]
          },
          "why": {
            "description": "One paragraph explaining why the answer is needed.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "AskClass": {
        "enum": [
          "security",
          "publish",
          "external_cost",
          "data",
          "scope",
          "run_health",
          "routine"
        ],
        "type": "string"
      },
      "AskExpiry": {
        "anyOf": [
          {
            "properties": {
              "answer": {
                "type": "string"
              }
            },
            "required": [
              "answer"
            ],
            "type": "object"
          },
          {
            "$ref": "#/definitions/AskExpiryBlock"
          }
        ]
      },
      "AskExpiryBlock": {
        "enum": [
          "block"
        ],
        "type": "string"
      },
      "AskOption": {
        "properties": {
          "description": {
            "description": "Optional one-line explanation shown under the label.",
            "type": [
              "string",
              "null"
            ]
          },
          "label": {
            "description": "The choice as the user sees and sends it, 1-80 characters, unique within its question.",
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "recommended": {
            "description": "Marks the agent's preferred choice. At most one option per question.",
            "type": "boolean"
          }
        },
        "required": [
          "label"
        ],
        "type": "object"
      },
      "AskQuestion": {
        "properties": {
          "header": {
            "description": "Short chip label such as `Approach`; prefixes the answer line (`Approach: <label>`). No length limit: the card shows a long one with an ellipsis and the whole text on hover.",
            "minLength": 1,
            "type": "string"
          },
          "multi_select": {
            "default": false,
            "description": "Let the user pick several options (checkboxes) instead of one.",
            "type": "boolean"
          },
          "options": {
            "description": "2-4 discrete choices; do not add an \"Other\" option, the UI adds a free-text one.",
            "items": {
              "$ref": "#/definitions/AskOption"
            },
            "maxItems": 4,
            "minItems": 2,
            "type": "array"
          },
          "question": {
            "description": "The full question text shown above the options.",
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "header",
          "options",
          "question"
        ],
        "type": "object"
      },
      "AskStatus": {
        "oneOf": [
          {
            "description": "The card is shown; the answer arrives as the user's next message.",
            "enum": [
              "awaiting_answer"
            ],
            "type": "string"
          }
        ]
      }
    },
    "description": "What an accepted ask records as its result `details`: the card the UI draws and the ids it uses to tell an open question from an answered one.",
    "properties": {
      "about": {
        "$ref": "#/definitions/AskAbout"
      },
      "expires_in_min": {
        "format": "uint64",
        "minimum": 0.0,
        "type": [
          "integer",
          "null"
        ]
      },
      "on_expiry": {
        "$ref": "#/definitions/AskExpiry"
      },
      "question_id": {
        "description": "The function-call id of this ask.",
        "type": "string"
      },
      "questions": {
        "description": "The questions as shown, in request order.",
        "items": {
          "$ref": "#/definitions/AskQuestion"
        },
        "type": "array"
      },
      "session_id": {
        "type": "string"
      },
      "status": {
        "$ref": "#/definitions/AskStatus"
      },
      "turn_id": {
        "description": "The turn that asked; the question remains open if the session moves on.",
        "type": "string"
      }
    },
    "required": [
      "question_id",
      "questions",
      "session_id",
      "status",
      "turn_id"
    ],
    "title": "AskResponse",
    "type": "object"
  }
}
