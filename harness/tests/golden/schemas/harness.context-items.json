{
  "function_id": "harness::context-items",
  "request_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "properties": {
      "session_id": {
        "type": "string"
      }
    },
    "required": [
      "session_id"
    ],
    "title": "ContextItemsRequest",
    "type": "object"
  },
  "response_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "definitions": {
      "AttachmentItem": {
        "properties": {
          "attachment_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "direction": {
            "description": "`sent` (in a user message) or `received` (in a function result or an assistant message, or a file the agent wrote).",
            "type": "string"
          },
          "entry_id": {
            "type": "string"
          },
          "mime": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "path": {
            "description": "For a file the agent wrote: its absolute path on the engine's computer.",
            "type": [
              "string",
              "null"
            ]
          },
          "size": {
            "format": "uint64",
            "minimum": 0.0,
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "direction",
          "entry_id",
          "mime",
          "name"
        ],
        "type": "object"
      },
      "ImageItem": {
        "properties": {
          "attachment_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "block_index": {
            "description": "The `image` block's index in the entry's message content.",
            "format": "uint64",
            "minimum": 0.0,
            "type": "integer"
          },
          "direction": {
            "description": "`sent` or `received`, by the attachments' rule.",
            "type": "string"
          },
          "entry_id": {
            "type": "string"
          },
          "mime": {
            "type": "string"
          }
        },
        "required": [
          "block_index",
          "direction",
          "entry_id",
          "mime"
        ],
        "type": "object"
      },
      "LinkItem": {
        "properties": {
          "count": {
            "description": "Mentions in the conversation.",
            "format": "uint64",
            "minimum": 0.0,
            "type": "integer"
          },
          "entry_id": {
            "description": "The newest entry naming it.",
            "type": "string"
          },
          "host": {
            "type": "string"
          },
          "title": {
            "description": "The text of a Markdown `[text](url)`.",
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "count",
          "entry_id",
          "host",
          "url"
        ],
        "type": "object"
      },
      "PullRequestItem": {
        "properties": {
          "checks": {
            "description": "`passing`, `failing` or `pending`; absent without checks.",
            "type": [
              "string",
              "null"
            ]
          },
          "entry_id": {
            "description": "The newest entry naming it.",
            "type": "string"
          },
          "number": {
            "format": "uint64",
            "minimum": 0.0,
            "type": "integer"
          },
          "repo": {
            "description": "`owner/name`, lower case.",
            "type": "string"
          },
          "source": {
            "description": "`created` (a `github::pr::create` result) or `mentioned`.",
            "type": "string"
          },
          "state": {
            "description": "`open`, `draft`, `merged` or `closed`; absent without the github worker.",
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "entry_id",
          "number",
          "repo",
          "source",
          "url"
        ],
        "type": "object"
      },
      "SideChatItem": {
        "description": "One side chat of the conversation (chat-projects phase 2): the pane row \"<title> · 6 messages · 10m\", with a dot while a turn runs.",
        "properties": {
          "created_at_ms": {
            "format": "int64",
            "type": "integer"
          },
          "from_entry_id": {
            "description": "The conversation's entry it was forked at (`side_chat_fork_point`), for the mark under that message; absent for a side chat forked before phase 2.",
            "type": [
              "string",
              "null"
            ]
          },
          "message_count": {
            "description": "Messages added in the side chat since the fork (user, assistant and function results; 0 while nothing was sent). A side chat forked before phase 2 records no fork point: all its messages count.",
            "format": "uint64",
            "minimum": 0.0,
            "type": "integer"
          },
          "running": {
            "description": "A turn is running in it (`status == \"running\"`).",
            "type": "boolean"
          },
          "session_id": {
            "type": "string"
          },
          "status": {
            "description": "`running`, `done` or `failed`, from its session status (as subagents).",
            "type": "string"
          },
          "title": {
            "description": "\"Side chat\" until its first message names it.",
            "type": "string"
          },
          "updated_at_ms": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "created_at_ms",
          "message_count",
          "running",
          "session_id",
          "status",
          "title",
          "updated_at_ms"
        ],
        "type": "object"
      },
      "SubagentItem": {
        "properties": {
          "descendants": {
            "description": "Sessions below this one (its own subagents and theirs).",
            "format": "uint64",
            "minimum": 0.0,
            "type": "integer"
          },
          "display": {
            "description": "The `subagent_display` label (for example \"Explore\").",
            "type": [
              "string",
              "null"
            ]
          },
          "ended_at_ms": {
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "session_id": {
            "type": "string"
          },
          "started_at_ms": {
            "format": "int64",
            "type": "integer"
          },
          "status": {
            "description": "`running`, `done` or `failed`.",
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "descendants",
          "session_id",
          "started_at_ms",
          "status",
          "title"
        ],
        "type": "object"
      },
      "Truncated": {
        "properties": {
          "attachments": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "images": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "links": {
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "type": "object"
      }
    },
    "properties": {
      "attachments": {
        "items": {
          "$ref": "#/definitions/AttachmentItem"
        },
        "type": "array"
      },
      "generated_at_ms": {
        "format": "int64",
        "type": "integer"
      },
      "images": {
        "items": {
          "$ref": "#/definitions/ImageItem"
        },
        "type": "array"
      },
      "links": {
        "items": {
          "$ref": "#/definitions/LinkItem"
        },
        "type": "array"
      },
      "message_count": {
        "format": "uint64",
        "minimum": 0.0,
        "type": "integer"
      },
      "pull_requests": {
        "items": {
          "$ref": "#/definitions/PullRequestItem"
        },
        "type": "array"
      },
      "session_id": {
        "type": "string"
      },
      "side_chats": {
        "items": {
          "$ref": "#/definitions/SideChatItem"
        },
        "type": "array"
      },
      "subagents": {
        "items": {
          "$ref": "#/definitions/SubagentItem"
        },
        "type": "array"
      },
      "truncated": {
        "$ref": "#/definitions/Truncated"
      }
    },
    "required": [
      "attachments",
      "generated_at_ms",
      "images",
      "links",
      "message_count",
      "pull_requests",
      "session_id",
      "side_chats",
      "subagents",
      "truncated"
    ],
    "title": "ContextItemsResponse",
    "type": "object"
  }
}
