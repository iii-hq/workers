# Optional seed file for first-time registration
# (`iii-directory --config ./config.yaml.example`).
#
# As of this version, iii-directory's runtime config lives in the
# `configuration` worker under id `iii-directory` (the same pattern
# `database` and `storage` use). This file is only a SEED: when the worker
# is launched with `--config <this file>` AND no value is yet stored for id
# `iii-directory`, its contents are passed as `initial_value` on
# `configuration::register` (the configuration worker env-expands `${VAR}`).
# After that first register the stored value is authoritative; edit it with
# `configuration::set id=iii-directory` (or the console Workers tab), or by
# editing `./data/configuration/iii-directory.yaml` directly.
#
# Tunable fields hot-reload on change (registry_url, download_timeout_ms,
# registry_cache_ttl_ms, filter_unregistered, function_search_mode and all
# function_search_jev_* options). Topology fields require a
# worker restart (skills_folder, local_skills_folder, agents_folder,
# global_agents_folder, agents_skills_folder, global_agents_skills_folder,
# auto_download, function_search_model_path, function_search_model_download).
#
# When omitted entirely, the worker seeds the built-in defaults
# (skills_folder: skills, agents_folder: agents,
# registry_url: https://api.workers.iii.dev).

# Folder that backs every read (`directory::skills::list`,
# `directory::skills::get`, `directory::system-prompts::*`) and every write
# from `directory::skills::download`. Relative paths are resolved
# against III_COMPOSE_DIR (or the process current working directory when
# running outside Compose); absolute paths are
# used as-is.
skills_folder: ./skills

# Read-write root for reusable agent profiles. Each agent is one direct
# `<id>.md` file. Relative paths resolve like skills_folder.
agents_folder: ./agents

# USER-GLOBAL agent profile root, shared by every project on the machine.
# Same direct <id>.md scan as agents_folder; an id present under
# agents_folder shadows the same id here. Profiles resolved here are updated
# and deleted in place; create still writes agents_folder only. A missing
# directory is treated as empty and never materialized.
# global_agents_folder: ~/.iii/agents

# Read-only root for system-installed agent skills (one directory per
# skill, each containing a SKILL.md). Scanned shallowly; a missing
# directory is treated as empty and the worker never writes here.
# agents_skills_folder: .agents/skills

# Read-only USER-GLOBAL agent skills root — the home-directory side of the
# ~/.agents/skills convention, shared by every project on the machine. Same
# scan and read-only contract as agents_skills_folder; namespaces present in
# the managed roots or the project agents root shadow the same namespace here.
# global_agents_skills_folder: ~/.agents/skills

# Workers registry base URL — used by `directory::skills::download` and
# the `directory::registry::*` proxies when a `worker=` source is
# specified.
registry_url: https://api.workers.iii.dev

# Timeout for a single download (`git clone` or HTTP request) in ms.
download_timeout_ms: 60000

# --- Function search (tunable, hot-reload) ---

# Search lane: hybrid (BM25 fused with the local MiniLM model) is the default.
# Lexical is BM25 only. Hybrid serves BM25 until the model bundle below is ready.
# Jev uses the remote TypeSafe service independently of MiniLM, including when
# function_search_model_path is null. Set function_search_mode: jev to enable it.
function_search_mode: hybrid

# Jev options (hot-reloadable, including the credential).
# Optional TypeSafe key, also editable in the console's masked Jev API key field.
# A configured value takes precedence over TYPESAFE_API_KEY captured from the
# worker process environment at startup. Missing, null or blank restores that
# environment fallback. New searches use changes immediately; in-flight searches
# keep their original key. The configuration service persists configured keys.
function_search_jev_api_key: null
# The model must be a non-empty string.
function_search_jev_model: jev-1.13.0
# Integer 1..30000 ms for all Jev calls in a public search, shared across batches.
# Registry HTTP requests have separate timeouts, so total search time may exceed it.
function_search_jev_timeout_ms: 3000
# Finite 0..1 inclusive; 0.5 is an initial calibration value.
function_search_jev_min_relevance: 0.5
# A valid result with no relevant functions stays empty. Missing credentials,
# timeouts and service/protocol errors use lexical fallback for the affected batch.
# Registry Jev ranking evaluates only the pool returned by upstream lexical search;
# it cannot recover workers that the registry did not return.

# Local semantic model directory: the pinned MiniLM bundle. Changing it
# requires restart; `null` disables the Hybrid semantic lane, not Jev.
# function_search_model_path: ~/.cache/iii/all-MiniLM-L6-v2-c9745ed1d9f207416be6d2e6f8de32d1f16199bf

# With Hybrid and a missing/incomplete bundle at boot, download the
# pinned files from Hugging Face once (each verified by length and SHA-256).
# Set false for air-gapped stacks; Hybrid then stays BM25-only until the
# bundle is provisioned by hand.
function_search_model_download: true

# Bind the directory::pre-generate hook so the conditional search hint can
# be injected into agent generations. Off unbinds the hook entirely.
inject_hint: true

# Only inject the search hint when the session's surface spans at least
# this many distinct non-engine workers. 0 hints on every surface.
hint_min_workers: 2

# Also search the public worker registry (verified authors only) on every
# directory::search_functions call and return matching NOT-installed
# workers as an `installable` section alongside the installed results.
registry_search: true
