{
  "function_id": "eval::reproduce",
  "request_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "definitions": {
      "ChangeEditV1": {
        "additionalProperties": false,
        "description": "One edit of what the model saw. `target` is an entry id of the conversation before the decision point, or `system_prompt`. An edit either replaces `find` with `replace` in the target's text or removes the entry.",
        "properties": {
          "find": {
            "type": [
              "string",
              "null"
            ]
          },
          "remove": {
            "type": "boolean"
          },
          "replace": {
            "type": [
              "string",
              "null"
            ]
          },
          "target": {
            "type": "string"
          }
        },
        "required": [
          "target"
        ],
        "type": "object"
      },
      "ReproduceChangeV1": {
        "description": "What a reproduction changes in the request.",
        "oneOf": [
          {
            "properties": {
              "kind": {
                "enum": [
                  "none"
                ],
                "type": "string"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          {
            "properties": {
              "kind": {
                "enum": [
                  "proposed"
                ],
                "type": "string"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          {
            "properties": {
              "edits": {
                "items": {
                  "$ref": "#/definitions/ChangeEditV1"
                },
                "type": "array"
              },
              "kind": {
                "enum": [
                  "custom"
                ],
                "type": "string"
              }
            },
            "required": [
              "edits",
              "kind"
            ],
            "type": "object"
          }
        ]
      },
      "SignalRuleV1": {
        "oneOf": [
          {
            "description": "The reply asks `engine::functions::info` only for contracts an earlier result in the context already supplied.",
            "enum": [
              "contract_rediscovery"
            ],
            "type": "string"
          },
          {
            "description": "The reply repeats the last call that failed: same target, equal payload.",
            "enum": [
              "repeated_error_call"
            ],
            "type": "string"
          }
        ]
      },
      "SignalV1": {
        "additionalProperties": false,
        "description": "How to recognize the behavior in one reply: exactly one of a rule computed in code or a yes/no question Jev answers about the reply.",
        "properties": {
          "question": {
            "type": [
              "string",
              "null"
            ]
          },
          "rule": {
            "anyOf": [
              {
                "$ref": "#/definitions/SignalRuleV1"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object"
      },
      "SuggestionCheckV1": {
        "additionalProperties": false,
        "description": "How a suggestion is checked at the step where its behavior happened.",
        "properties": {
          "change": {
            "default": [],
            "description": "The proposed change as edits of what the model saw before that step; empty when it cannot be expressed as text.",
            "items": {
              "$ref": "#/definitions/ChangeEditV1"
            },
            "type": "array"
          },
          "decision_point": {
            "description": "The assistant entry where the behavior happened (`…_<step>_assistant`), one of the suggestion's `evidence` entries.",
            "type": "string"
          },
          "signal": {
            "$ref": "#/definitions/SignalV1"
          }
        },
        "required": [
          "decision_point",
          "signal"
        ],
        "type": "object"
      }
    },
    "description": "`eval::reproduce`.",
    "properties": {
      "_caller_worker_id": {
        "default": null,
        "description": "Stamped by the engine on every invocation; callers omit it.",
        "type": [
          "string",
          "null"
        ]
      },
      "by": {
        "default": null,
        "type": [
          "string",
          "null"
        ]
      },
      "change": {
        "allOf": [
          {
            "$ref": "#/definitions/ReproduceChangeV1"
          }
        ],
        "default": {
          "kind": "none"
        }
      },
      "check": {
        "anyOf": [
          {
            "$ref": "#/definitions/SuggestionCheckV1"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "The decision point and signal, for a suggestion without a `check` (an older analysis) or to override it."
      },
      "dry_run": {
        "default": false,
        "description": "Rebuild the request and check its fidelity without sampling: nothing is spent or stored.",
        "type": "boolean"
      },
      "evaluation_id": {
        "type": "string"
      },
      "extend": {
        "default": null,
        "description": "Add replies to this earlier reproduction of the suggestion, with its change; with `samples: 0`, only finish what a failure left undone.",
        "type": [
          "string",
          "null"
        ]
      },
      "samples": {
        "default": null,
        "description": "Replies to sample, 1–50; default 20.",
        "format": "uint32",
        "minimum": 0.0,
        "type": [
          "integer",
          "null"
        ]
      },
      "suggestion_index": {
        "format": "uint",
        "minimum": 0.0,
        "type": "integer"
      }
    },
    "required": [
      "evaluation_id",
      "suggestion_index"
    ],
    "title": "ReproduceRequestV1",
    "type": "object"
  },
