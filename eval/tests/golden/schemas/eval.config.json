{
  "function_id": "eval::config",
  "request_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "properties": {
      "check_providers": {
        "default": false,
        "description": "Also ask the triage provider whether it answers (`judge::models::list`).",
        "type": "boolean"
      }
    },
    "title": "MonitorStateRequestV1",
    "type": "object"
  },
  "response_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "definitions": {
      "AnalysisCostStatsV1": {
        "additionalProperties": false,
        "description": "Cost of the completed analyses that investigated with the configured model, provider and code access (or lack of it).",
        "properties": {
          "count": {
            "description": "Analyses with a known cost; `min`, `median` and `max` come from them.",
            "format": "uint32",
            "minimum": 0.0,
            "type": "integer"
          },
          "max": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "median": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "min": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "unknown": {
            "description": "Analyses that investigated but reported no cost.",
            "format": "uint32",
            "minimum": 0.0,
            "type": "integer"
          }
        },
        "required": [
          "count",
          "unknown"
        ],
        "type": "object"
      },
      "MonitorConfigV1": {
        "additionalProperties": false,
        "properties": {
          "code_repository": {
            "description": "The codebase directory the investigation reads (see `ConfigureRequestV1`).",
            "type": [
              "string",
              "null"
            ]
          },
          "daily_cost_cap_usd": {
            "description": "The daily cap on known investigation cost (see `ConfigureRequestV1`).",
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "enabled": {
            "type": "boolean"
          },
          "model": {
            "$ref": "#/definitions/MonitorModelV1"
          },
          "revision": {
            "description": "SHA-256 of the effective configuration; analyses keep the revision they were admitted with.",
            "type": "string"
          },
          "updated_at": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "enabled",
          "model",
          "revision",
          "updated_at"
        ],
        "type": "object"
      },
      "MonitorCostV1": {
        "additionalProperties": false,
        "description": "The monitor's own spend. Only the investigation's LLM cost is in dollars; Jev's usage is reported in tokens on each record.",
        "properties": {
          "cap_usd": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "capped": {
            "description": "A cap is set and `today_capture_usd`, plus the median cost of each investigation still running, reached it: no automatic analysis starts an investigation until the next UTC day.",
            "type": "boolean"
          },
          "per_analysis": {
            "allOf": [
              {
                "$ref": "#/definitions/AnalysisCostStatsV1"
              }
            ],
            "description": "What one investigation has cost, from the history."
          },
          "since": {
            "description": "Start (ms since the Unix epoch) of the UTC day the `today_*` values cover. The monitor has no timezone setting, so a day is a UTC day.",
            "format": "int64",
            "type": "integer"
          },
          "today_capture_usd": {
            "description": "The capture bucket, the only one the cap compares: the larger of the day's persisted capture spend (deleting an analysis does not give it back) and the sum of the stored analyses' `usage.llm_cost_usd`. A day persisted before the buckets counts entirely as capture.",
            "format": "double",
            "type": "number"
          },
          "today_unknown": {
            "description": "Analyses of the day whose investigation started but reported no cost. They add nothing to `today_capture_usd`, but their cost is unknown, not zero.",
            "format": "uint32",
            "minimum": 0.0,
            "type": "integer"
          },
          "today_usd": {
            "description": "Everything the monitor is known to have spent since `since`: equal to `today_capture_usd`.",
            "format": "double",
            "type": "number"
          }
        },
        "required": [
          "capped",
          "per_analysis",
          "since",
          "today_capture_usd",
          "today_unknown",
          "today_usd"
        ],
        "type": "object"
      },
      "MonitorLimitsV1": {
        "additionalProperties": false,
        "properties": {
          "analysis_budget_ms": {
            "description": "Whole-analysis budget from admission, queue wait included.",
            "format": "uint64",
            "minimum": 0.0,
            "type": "integer"
          },
          "assets_bytes": {
            "format": "uint64",
            "minimum": 0.0,
            "type": "integer"
          },
          "investigation_code_max_total_tokens": {
            "description": "Total-token cap of an investigation that has code access.",
            "format": "uint64",
            "minimum": 0.0,
            "type": "integer"
          },
          "investigation_code_max_turns": {
            "description": "Generate-step cap of an investigation that has code access.",
            "format": "uint32",
            "minimum": 0.0,
            "type": "integer"
          },
          "investigation_max_output_tokens": {
            "format": "uint64",
            "minimum": 0.0,
            "type": "integer"
          },
          "investigation_max_total_tokens": {
            "format": "uint64",
            "minimum": 0.0,
            "type": "integer"
          },
          "investigation_max_turns": {
            "format": "uint32",
            "minimum": 0.0,
            "type": "integer"
          },
          "judge_timeout_ms": {
            "format": "uint64",
            "minimum": 0.0,
            "type": "integer"
          },
          "max_active_analyses": {
            "format": "uint32",
            "minimum": 0.0,
            "type": "integer"
          },
          "model_context_bytes": {
            "description": "Serialized JSON shown to a model (bytes, not tokens).",
            "format": "uint64",
            "minimum": 0.0,
            "type": "integer"
          },
          "queue_concurrency": {
            "format": "uint32",
            "minimum": 0.0,
            "type": "integer"
          },
          "retention_days": {
            "format": "uint32",
            "minimum": 0.0,
            "type": "integer"
          },
          "retention_max_terminal": {
            "format": "uint32",
            "minimum": 0.0,
            "type": "integer"
          }
        },
        "required": [
          "analysis_budget_ms",
          "assets_bytes",
          "investigation_code_max_total_tokens",
          "investigation_code_max_turns",
          "investigation_max_output_tokens",
          "investigation_max_total_tokens",
          "investigation_max_turns",
          "judge_timeout_ms",
          "max_active_analyses",
          "model_context_bytes",
          "queue_concurrency",
          "retention_days",
          "retention_max_terminal"
        ],
        "type": "object"
      },
      "MonitorModelV1": {
        "additionalProperties": false,
        "description": "The Harness model the user chose for investigations. Credentials stay in the provider worker; this request never carries a key.",
        "properties": {
          "model": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "provider_options": {
            "additionalProperties": true,
            "description": "Provider-native options, namespaced by the selected provider id.",
            "type": [
              "object",
              "null"
            ]
          },
          "thinking_level": {
            "anyOf": [
              {
                "$ref": "#/definitions/ThinkingLevel"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "model",
          "provider"
        ],
        "type": "object"
      },
      "ThinkingLevel": {
        "oneOf": [
          {
            "enum": [
              "minimal",
              "low",
              "medium",
              "high",
              "xhigh"
            ],
            "type": "string"
          },
          {
            "description": "No reasoning at all; honoured only where the model advertises `supports_thinking_off` (elsewhere the provider falls back to its own lowest setting, or omits the parameter, and warns).",
            "enum": [
              "off"
            ],
            "type": "string"
          }
        ]
      },
      "TriageAvailabilityV1": {
        "additionalProperties": false,
        "description": "What `judge::models::list` answered for the triage provider. The key stays in the provider; this only reports whether it answers.",
        "properties": {
          "available": {
            "type": "boolean"
          },
          "checked_at": {
            "format": "int64",
            "type": "integer"
          },
          "code": {
            "description": "The provider's error code (`missing_key`, `provider_unavailable`…), or `unreachable` when the hub did not answer.",
            "type": [
              "string",
              "null"
            ]
          },
          "models": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "provider": {
            "type": "string"
          }
        },
        "required": [
          "available",
          "checked_at",
          "models",
          "provider"
        ],
        "type": "object"
      }
    },
    "properties": {
      "config": {
        "anyOf": [
          {
            "$ref": "#/definitions/MonitorConfigV1"
          },
          {
            "type": "null"
          }
        ],
        "description": "`null` until the user configures the monitor."
      },
      "cost": {
        "allOf": [
          {
            "$ref": "#/definitions/MonitorCostV1"
          }
        ],
        "description": "What the investigations cost so far, to decide before enabling."
      },
      "limits": {
        "allOf": [
          {
            "$ref": "#/definitions/MonitorLimitsV1"
          }
        ],
        "description": "The limits this version enforces, so the console never restates them."
      },
      "triage": {
        "anyOf": [
          {
            "$ref": "#/definitions/TriageAvailabilityV1"
          },
          {
            "type": "null"
          }
        ],
        "description": "Present when the request asked to check the triage provider."
      }
    },
    "required": [
      "cost",
      "limits"
    ],
    "title": "MonitorStateResponseV1",
    "type": "object"
  }
}
