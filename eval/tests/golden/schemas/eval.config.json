{
  "function_id": "eval::config",
  "request_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "properties": {
      "check_providers": {
        "default": false,
        "description": "Also ask the triage provider whether it answers (`judge::models::list`).",
        "type": "boolean"
      }
    },
    "title": "MonitorStateRequestV1",
    "type": "object"
  },
  "response_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "definitions": {
      "CapacityRejectionV1": {
        "additionalProperties": false,
        "properties": {
          "at": {
            "format": "int64",
            "type": "integer"
          },
          "session_id": {
            "type": "string"
          },
          "turn_id": {
            "type": "string"
          }
        },
        "required": [
          "at",
          "session_id",
          "turn_id"
        ],
        "type": "object"
      },
      "MonitorConfigV1": {
        "additionalProperties": false,
        "properties": {
          "code_repository": {
            "description": "The codebase directory the investigation reads (see `ConfigureRequestV1`).",
            "type": [
              "string",
              "null"
            ]
          },
          "enabled": {
            "type": "boolean"
          },
          "enabled_since": {
            "description": "When automatic observation last went from paused to on; analyses use it to bound which earlier turns they may report. Unchanged by edits that keep observation on.",
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "model": {
            "$ref": "#/definitions/MonitorModelV1"
          },
          "revision": {
            "description": "SHA-256 of the effective configuration; analyses keep the revision they were admitted with.",
            "type": "string"
          },
          "updated_at": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "enabled",
          "model",
          "revision",
          "updated_at"
        ],
        "type": "object"
      },
      "MonitorLimitsV1": {
        "additionalProperties": false,
        "properties": {
          "analysis_budget_ms": {
            "description": "Whole-analysis budget from admission, queue wait included.",
            "format": "uint64",
            "minimum": 0.0,
            "type": "integer"
          },
          "assets_bytes": {
            "format": "uint64",
            "minimum": 0.0,
            "type": "integer"
          },
          "audit_sample_percent": {
            "format": "uint32",
            "minimum": 0.0,
            "type": "integer"
          },
          "investigation_code_max_total_tokens": {
            "description": "Total-token cap of an investigation that has code access.",
            "format": "uint64",
            "minimum": 0.0,
            "type": "integer"
          },
          "investigation_code_max_turns": {
            "description": "Generate-step cap of an investigation that has code access.",
            "format": "uint32",
            "minimum": 0.0,
            "type": "integer"
          },
          "investigation_max_output_tokens": {
            "format": "uint64",
            "minimum": 0.0,
            "type": "integer"
          },
          "investigation_max_total_tokens": {
            "format": "uint64",
            "minimum": 0.0,
            "type": "integer"
          },
          "investigation_max_turns": {
            "format": "uint32",
            "minimum": 0.0,
            "type": "integer"
          },
          "judge_timeout_ms": {
            "format": "uint64",
            "minimum": 0.0,
            "type": "integer"
          },
          "low_confidence": {
            "format": "double",
            "type": "number"
          },
          "max_active_analyses": {
            "format": "uint32",
            "minimum": 0.0,
            "type": "integer"
          },
          "model_context_bytes": {
            "description": "Serialized JSON shown to a model (bytes, not tokens).",
            "format": "uint64",
            "minimum": 0.0,
            "type": "integer"
          },
          "queue_concurrency": {
            "format": "uint32",
            "minimum": 0.0,
            "type": "integer"
          },
          "retention_days": {
            "format": "uint32",
            "minimum": 0.0,
            "type": "integer"
          },
          "retention_max_terminal": {
            "format": "uint32",
            "minimum": 0.0,
            "type": "integer"
          }
        },
        "required": [
          "analysis_budget_ms",
          "assets_bytes",
          "audit_sample_percent",
          "investigation_code_max_total_tokens",
          "investigation_code_max_turns",
          "investigation_max_output_tokens",
          "investigation_max_total_tokens",
          "investigation_max_turns",
          "judge_timeout_ms",
          "low_confidence",
          "max_active_analyses",
          "model_context_bytes",
          "queue_concurrency",
          "retention_days",
          "retention_max_terminal"
        ],
        "type": "object"
      },
      "MonitorModelV1": {
        "additionalProperties": false,
        "description": "The Harness model the user chose for investigations. Credentials stay in the provider worker; this request never carries a key.",
        "properties": {
          "model": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "provider_options": {
            "additionalProperties": true,
            "description": "Provider-native options, namespaced by the selected provider id.",
            "type": [
              "object",
              "null"
            ]
          },
          "thinking_level": {
            "anyOf": [
              {
                "$ref": "#/definitions/ThinkingLevel"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "model",
          "provider"
        ],
        "type": "object"
      },
      "ThinkingLevel": {
        "enum": [
          "minimal",
          "low",
          "medium",
          "high",
          "xhigh"
        ],
        "type": "string"
      },
      "TriageAvailabilityV1": {
        "additionalProperties": false,
        "description": "What `judge::models::list` answered for the triage provider. The key stays in the provider; this only reports whether it answers.",
        "properties": {
          "available": {
            "type": "boolean"
          },
          "checked_at": {
            "format": "int64",
            "type": "integer"
          },
          "code": {
            "description": "The provider's error code (`missing_key`, `provider_unavailable`…), or `unreachable` when the hub did not answer.",
            "type": [
              "string",
              "null"
            ]
          },
          "models": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "provider": {
            "type": "string"
          }
        },
        "required": [
          "available",
          "checked_at",
          "models",
          "provider"
        ],
        "type": "object"
      }
    },
    "properties": {
      "config": {
        "anyOf": [
          {
            "$ref": "#/definitions/MonitorConfigV1"
          },
          {
            "type": "null"
          }
        ],
        "description": "`null` until the user configures the monitor."
      },
      "last_rejection": {
        "anyOf": [
          {
            "$ref": "#/definitions/CapacityRejectionV1"
          },
          {
            "type": "null"
          }
        ],
        "description": "The latest turn not admitted because the monitor was at capacity."
      },
      "limits": {
        "allOf": [
          {
            "$ref": "#/definitions/MonitorLimitsV1"
          }
        ],
        "description": "The limits this version enforces, so the console never restates them."
      },
      "observer_bound": {
        "description": "False when the `harness::turn-completed` binding was refused locally: automatic observation is unavailable even if `config.enabled` is true. The SDK does not wait for the engine's acknowledgement, so true means the binding was requested, not confirmed.",
        "type": "boolean"
      },
      "observer_error": {
        "type": [
          "string",
          "null"
        ]
      },
      "triage": {
        "anyOf": [
          {
            "$ref": "#/definitions/TriageAvailabilityV1"
          },
          {
            "type": "null"
          }
        ],
        "description": "Present when the request asked to check the triage provider."
      }
    },
    "required": [
      "limits",
      "observer_bound"
    ],
    "title": "MonitorStateResponseV1",
    "type": "object"
  }
}
