{
  "function_id": "eval::configure",
  "request_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "definitions": {
      "MonitorModelV1": {
        "additionalProperties": false,
        "description": "The Harness model the user chose for investigations. Credentials stay in the provider worker; this request never carries a key.",
        "properties": {
          "model": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "provider_options": {
            "additionalProperties": true,
            "description": "Provider-native options, namespaced by the selected provider id.",
            "type": [
              "object",
              "null"
            ]
          },
          "thinking_level": {
            "anyOf": [
              {
                "$ref": "#/definitions/ThinkingLevel"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "model",
          "provider"
        ],
        "type": "object"
      },
      "ThinkingLevel": {
        "enum": [
          "minimal",
          "low",
          "medium",
          "high",
          "xhigh"
        ],
        "type": "string"
      }
    },
    "properties": {
      "_caller_worker_id": {
        "description": "Stamped by the engine on every invocation; callers omit it. Listed so the closed schema still accepts the engine's metadata.",
        "type": [
          "string",
          "null"
        ],
        "writeOnly": true
      },
      "code_repository": {
        "description": "Absolute path of the codebase directory the investigation reads and runs in (normally the iii workers repository, checked out on the monitor's host); absent means no code access.",
        "type": [
          "string",
          "null"
        ]
      },
      "enabled": {
        "type": "boolean"
      },
      "model": {
        "$ref": "#/definitions/MonitorModelV1"
      }
    },
    "required": [
      "enabled",
      "model"
    ],
    "title": "ConfigureRequestV1",
    "type": "object"
  },
  "response_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "definitions": {
      "MonitorModelV1": {
        "additionalProperties": false,
        "description": "The Harness model the user chose for investigations. Credentials stay in the provider worker; this request never carries a key.",
        "properties": {
          "model": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "provider_options": {
            "additionalProperties": true,
            "description": "Provider-native options, namespaced by the selected provider id.",
            "type": [
              "object",
              "null"
            ]
          },
          "thinking_level": {
            "anyOf": [
              {
                "$ref": "#/definitions/ThinkingLevel"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "model",
          "provider"
        ],
        "type": "object"
      },
      "ThinkingLevel": {
        "enum": [
          "minimal",
          "low",
          "medium",
          "high",
          "xhigh"
        ],
        "type": "string"
      }
    },
    "properties": {
      "code_repository": {
        "description": "The codebase directory the investigation reads (see `ConfigureRequestV1`).",
        "type": [
          "string",
          "null"
        ]
      },
      "enabled": {
        "type": "boolean"
      },
      "enabled_since": {
        "description": "When automatic observation last went from paused to on; analyses use it to bound which earlier turns they may report. Unchanged by edits that keep observation on.",
        "format": "int64",
        "type": [
          "integer",
          "null"
        ]
      },
      "model": {
        "$ref": "#/definitions/MonitorModelV1"
      },
      "revision": {
        "description": "SHA-256 of the effective configuration; analyses keep the revision they were admitted with.",
        "type": "string"
      },
      "updated_at": {
        "format": "int64",
        "type": "integer"
      }
    },
    "required": [
      "enabled",
      "model",
      "revision",
      "updated_at"
    ],
    "title": "MonitorConfigV1",
    "type": "object"
  }
}
