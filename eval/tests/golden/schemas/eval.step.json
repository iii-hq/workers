{
  "function_id": "eval::step",
  "request_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "properties": {
      "cycle_id": {
        "type": "string"
      },
      "step": {
        "format": "uint64",
        "minimum": 0.0,
        "type": "integer"
      }
    },
    "required": [
      "cycle_id",
      "step"
    ],
    "title": "StepRequestV1",
    "type": "object"
  },
  "response_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "definitions": {
      "CycleStatusV1": {
        "oneOf": [
          {
            "enum": [
              "queued",
              "running",
              "completed",
              "failed",
              "cancelled"
            ],
            "type": "string"
          },
          {
            "description": "Durably paused on an external event: an E2E execution to finish, or the candidate stage (`next`).",
            "enum": [
              "waiting"
            ],
            "type": "string"
          }
        ]
      }
    },
    "properties": {
      "skipped": {
        "type": "boolean"
      },
      "status": {
        "$ref": "#/definitions/CycleStatusV1"
      }
    },
    "required": [
      "skipped",
      "status"
    ],
    "title": "StepResponseV1",
    "type": "object"
  }
}
