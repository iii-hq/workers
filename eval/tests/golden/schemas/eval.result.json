      },
      "FunctionPolicy": {
        "additionalProperties": false,
        "description": "The turn's structural dispatch policy (harness.md § Functions). A present policy is permissive by default: omitting `allow` permits every function not matched by `deny`. `allow` remains as a backwards-compatible positive scope for restricted consumers; an explicit empty list denies everything. A missing policy on a persisted turn remains deny-all.",
        "properties": {
          "allow": {
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "deny": {
            "default": [],
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "expose": {
            "allOf": [
              {
                "$ref": "#/definitions/ExposeMode"
              }
            ],
            "default": "agent_trigger"
          }
        },
        "type": "object"
      },
