{
  "function_id": "eval::start",
  "request_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "description": "Exactly one of `objective`, `execution_id` or `retry`.",
    "properties": {
      "execution_id": {
        "default": null,
        "type": [
          "string",
          "null"
        ]
      },
      "objective": {
        "default": null,
        "type": [
          "string",
          "null"
        ]
      },
      "retry": {
        "default": null,
        "description": "An ended cycle to measure again from its finding: its input, source analysis and a triage that proceeded are reused, under the current configuration.",
        "type": [
          "string",
          "null"
        ]
      }
    },
    "title": "CycleStartRequestV1",
    "type": "object"
  },
  "response_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "definitions": {
      "CycleStatusV1": {
        "oneOf": [
          {
            "enum": [
              "queued",
              "running",
              "completed",
              "failed",
              "cancelled"
            ],
            "type": "string"
          },
          {
            "description": "Durably paused on an external event: an E2E execution to finish, or the candidate stage (`next`).",
            "enum": [
              "waiting"
            ],
            "type": "string"
          }
        ]
      }
    },
    "properties": {
      "cycle_id": {
        "type": "string"
      },
      "status": {
        "$ref": "#/definitions/CycleStatusV1"
      }
    },
    "required": [
      "cycle_id",
      "status"
    ],
    "title": "CycleStartResponseV1",
    "type": "object"
  }
}
