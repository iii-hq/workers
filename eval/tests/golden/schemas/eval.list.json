{
  "function_id": "eval::list",
  "request_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "properties": {
      "limit": {
        "default": null,
        "format": "uint32",
        "minimum": 0.0,
        "type": [
          "integer",
          "null"
        ]
      }
    },
    "title": "CycleListRequestV1",
    "type": "object"
  },
  "response_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "definitions": {
      "CycleEventV1": {
        "additionalProperties": false,
        "description": "One status change of a cycle, oldest first in `CycleRecordV1::history`.",
        "properties": {
          "at": {
            "format": "int64",
            "type": "integer"
          },
          "detail": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "$ref": "#/definitions/CycleStatusV1"
          }
        },
        "required": [
          "at",
          "status"
        ],
        "type": "object"
      },
      "CycleInputV1": {
        "description": "What started a loop cycle: a free objective, or an existing E2E execution. Both start the same cycle and land in the same history.",
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "objective": {
                "type": "string"
              }
            },
            "required": [
              "objective"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "execution_id": {
                "type": "string"
              }
            },
            "required": [
              "execution_id"
            ],
            "type": "object"
          }
        ]
      },
      "CycleRecordV1": {
        "additionalProperties": false,
        "description": "The one record of a loop cycle, whichever input started it.",
        "properties": {
          "completed_at": {
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "created_at": {
            "format": "int64",
            "type": "integer"
          },
          "cycle_id": {
            "type": "string"
          },
          "failure": {
            "type": [
              "string",
              "null"
            ]
          },
          "history": {
            "items": {
              "$ref": "#/definitions/CycleEventV1"
            },
            "type": "array"
          },
          "input": {
            "$ref": "#/definitions/CycleInputV1"
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/definitions/CycleResultV1"
              },
              {
                "type": "null"
              }
            ]
          },
          "schema_version": {
            "format": "uint32",
            "minimum": 0.0,
            "type": "integer"
          },
          "status": {
            "$ref": "#/definitions/CycleStatusV1"
          },
          "step": {
            "description": "Durable step counter; a queued step that does not match is stale.",
            "format": "uint64",
            "minimum": 0.0,
            "type": "integer"
          },
          "updated_at": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "created_at",
          "cycle_id",
          "history",
          "input",
          "schema_version",
          "status",
          "step",
          "updated_at"
        ],
        "type": "object"
      },
      "CycleResultV1": {
        "additionalProperties": false,
        "description": "What a finished cycle produced.",
        "properties": {
          "execution_ids": {
            "default": [],
            "description": "The E2E executions the cycle read or started.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "summary": {
            "type": "string"
          }
        },
        "required": [
          "summary"
        ],
        "type": "object"
      },
      "CycleStatusV1": {
        "enum": [
          "queued",
          "running",
          "completed",
          "failed",
          "cancelled"
        ],
        "type": "string"
      }
    },
    "description": "Every cycle, newest first, whichever input started it.",
    "properties": {
      "cycles": {
        "items": {
          "$ref": "#/definitions/CycleRecordV1"
        },
        "type": "array"
      }
    },
    "required": [
      "cycles"
    ],
    "title": "CycleListResponseV1",
    "type": "object"
  }
}
