{
  "description": "Internal observer of observability::on-span; queues the traces the tick names in error_trace_ids, or, from an engine that does not name them, reads the tick's traces in one call and queues those that hold an error.",
  "function_id": "sentinel::on-trace-activity",
  "request_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "definitions": {
      "Caller": {
        "description": "Who made an invocation. `worker_id` / `worker_name` are stamped by the engine from the calling connection; `function_id`, `invocation_id` and `parent` are asserted by the calling SDK.",
        "properties": {
          "function_id": {
            "description": "The handler the call was made from; absent for a top-level call.",
            "type": [
              "string",
              "null"
            ]
          },
          "invocation_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "parent": {
            "anyOf": [
              {
                "$ref": "#/definitions/ParentCaller"
              },
              {
                "type": "null"
              }
            ],
            "description": "The caller of that handler, one level only."
          },
          "worker_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "worker_name": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "InvocationStatus": {
        "enum": [
          "success",
          "error"
        ],
        "type": "string"
      },
      "ObservedError": {
        "description": "What a call failed with: [`Observed::error`], [`Call::error`](crate::Call::error).",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      },
      "ParentCaller": {
        "description": "[`Caller::parent`]: a caller without a parent of its own.",
        "properties": {
          "function_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "invocation_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "worker_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "worker_name": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "TraceActivityEventV1": {
        "description": "The `observability::on-span` event, delivered as output: the trace ids of one coalesced window.",
        "properties": {
          "error_trace_ids": {
            "default": null,
            "description": "The traces of the window that recorded an error span. An engine that names them spares the tick its read; `None` (an older engine) keeps it.",
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "trace_ids": {
            "default": [],
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    },
    "description": "What an observer's target receives when iii delivers: the observed call, per the observer's `capture`.\n\n```rust,no_run # use iii_sdk::{Error, IIIClient, Observed, RegisterFunction}; # use serde_json::Value; # fn demo(iii: &IIIClient) { iii.register_function( \"alerts::payment-failed\", RegisterFunction::new(|event: Observed<Value>| { println!(\"{} failed: {:?}\", event.function_id, event.error); Ok::<_, Error>(()) }), ); # } ```",
    "properties": {
      "activation_id": {
        "type": "string"
      },
      "caller": {
        "anyOf": [
          {
            "$ref": "#/definitions/Caller"
          },
          {
            "type": "null"
          }
        ]
      },
      "duration_ms": {
        "format": "double",
        "type": "number"
      },
      "error": {
        "anyOf": [
          {
            "$ref": "#/definitions/ObservedError"
          },
          {
            "type": "null"
          }
        ]
      },
      "function_id": {
        "type": "string"
      },
      "input": true,
      "invocation_id": {
        "type": "string"
      },
      "metadata": true,
      "namespace": {
        "type": [
          "string",
          "null"
        ]
      },
      "observer_id": {
        "type": "string"
      },
      "output": {
        "anyOf": [
          {
            "$ref": "#/definitions/TraceActivityEventV1"
          },
          {
            "type": "null"
          }
        ]
      },
      "started_at_ms": {
        "format": "uint64",
        "minimum": 0.0,
        "type": "integer"
      },
      "status": {
        "$ref": "#/definitions/InvocationStatus"
      }
    },
    "required": [
      "activation_id",
      "duration_ms",
      "function_id",
      "invocation_id",
      "observer_id",
      "started_at_ms",
      "status"
    ],
    "title": "Observed_for_AnyValue_and_TraceActivityEventV1",
    "type": "object"
  },
  "response_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "properties": {
      "phantom_dropped": {
        "description": "Ticks for this worker's own traces, dropped before the queue.",
        "format": "uint64",
        "minimum": 0.0,
        "type": "integer"
      },
      "queued": {
        "format": "uint64",
        "minimum": 0.0,
        "type": "integer"
      }
    },
    "required": [
      "phantom_dropped",
      "queued"
    ],
    "title": "QueuedResponseV1",
    "type": "object"
  }
}
