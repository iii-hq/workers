          },
          "worker_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "worker_name": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "InvocationStatus": {
        "enum": [
          "success",
          "error"
