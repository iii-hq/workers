        "type": "string"
      },
      "input": true,
      "invocation_id": {
        "type": "string"
      },
      "metadata": true,
      "namespace": {
        "type": [
          "string",
          "null"
        ]
      },
      "observer_id": {
        "type": "string"
      },
      "output": {
