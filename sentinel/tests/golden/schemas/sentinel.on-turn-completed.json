            "type": [
              "string",
              "null"
            ]
          },
          "invocation_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "worker_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "worker_name": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
