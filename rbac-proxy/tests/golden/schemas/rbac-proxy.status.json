{
  "description": "Check proxy health: bound host/port, the (credential-redacted) upstream engine URL, which authentication is in force (auth function, loopback grant, or none), which endpoints are exposed, and the live downstream connection count.",
  "function_id": "rbac-proxy::status",
  "request_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "StatusInput",
    "type": "object"
  },
  "response_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "definitions": {
      "AuthMode": {
        "description": "Which authentication admits new connections.",
        "oneOf": [
          {
            "description": "`rbac.auth_function_id` authenticates every connection.",
            "enum": [
              "function"
            ],
            "type": "string"
          },
          {
            "description": "No auth function; `rbac.loopback_auth` admits loopback peers only.",
            "enum": [
              "loopback"
            ],
            "type": "string"
          },
          {
            "description": "Neither: every connection is refused.",
            "enum": [
              "none"
            ],
            "type": "string"
          }
        ]
      }
    },
    "properties": {
      "active_connections": {
        "description": "Live downstream connections.",
        "format": "uint32",
        "minimum": 0.0,
        "type": "integer"
      },
      "auth": {
        "allOf": [
          {
            "$ref": "#/definitions/AuthMode"
          }
        ],
        "description": "The authentication in force for new connections: `function` (the `auth_function_id`), `loopback` (no auth function; `loopback_auth` admits loopback peers) or `none` (every connection is refused)."
      },
      "engine_url": {
        "description": "Upstream engine URL, with any `user:pass@` credentials redacted.",
        "type": "string"
      },
      "expose_endpoints": {
        "description": "The `rbac.expose_endpoints` patterns: the paths the proxy serves. Empty: every connection is refused.",
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "host": {
        "description": "Bound public host.",
        "type": "string"
      },
      "port": {
        "description": "Bound public RBAC port.",
        "format": "uint16",
        "minimum": 0.0,
        "type": "integer"
      },
      "rbac_enabled": {
        "description": "Whether an `auth_function_id` is configured.",
        "type": "boolean"
      },
      "version": {
        "description": "Worker version (matches `Cargo.toml`).",
        "type": "string"
      }
    },
    "required": [
      "active_connections",
      "auth",
      "engine_url",
      "expose_endpoints",
      "host",
      "port",
      "rbac_enabled",
      "version"
    ],
    "title": "StatusOutput",
    "type": "object"
  }
}
