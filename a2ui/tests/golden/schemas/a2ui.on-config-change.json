{
  "description": "Internal: reload authoritative A2UI configuration after a configuration update event.",
  "function_id": "a2ui::on-config-change",
  "request_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "properties": {
      "id": {
        "default": null,
        "description": "Advisory id only. The handler always re-fetches authoritative state.",
        "type": [
          "string",
          "null"
        ]
      }
    },
    "title": "OnConfigChangeEvent",
    "type": "object"
  },
  "response_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "properties": {
      "ok": {
        "type": "boolean"
      }
    },
    "required": [
      "ok"
    ],
    "title": "OnConfigChangeResponse",
    "type": "object"
  }
}
