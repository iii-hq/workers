workers:
  - name: storage
    config:
      providers:
        local:
          data_dir: data/storage
          http:
            bind_address: 0.0.0.0:49200
            public_url: http://10.0.0.42:49200

      buckets:
        uploads:
          provider: s3
          bucket: my-app-uploads
          region: us-east-1
          notifications:
            sqs_queue_url: https://sqs.us-east-1.amazonaws.com/123/my-app-uploads-events

        documents:
          provider: gcs
          bucket: my-app-documents
          # credentials_file: /etc/iii/gcs-sa.json

        avatars:
          provider: r2
          bucket: avatars
          # Credentials resolve through the secrets worker (consumer `storage`):
          # secret://NAME (its vault) or env://NAME. ${VAR} templates still work.
          account_id: env://R2_ACCOUNT_ID
          access_key_id: secret://STORAGE_AVATARS_ACCESS_KEY_ID
          secret_access_key: secret://STORAGE_AVATARS_SECRET_ACCESS_KEY
          display:
            icon: image
            color: "#F38020"

        scratch:
          provider: local
          bucket: scratch

triggers:
  - type: storage::object-created
    config:
      bucket: uploads

  - type: storage::object-deleted
    config:
      bucket: uploads
